local function wrappedLines(text, characterLimit, maximumLines)
    local result = {}
    local current = ""
    for word in tostring(text or ""):gmatch("%S+") do
        if #current > 0 and #current + #word + 1 > characterLimit then
            table.insert(result, current)
            current = word
            if #result >= maximumLines then break end
        else
            current = current == "" and word or (current .. " " .. word)
        end
    end
    if current ~= "" and #result < maximumLines then table.insert(result, current) end
    if #result == 0 then table.insert(result, "") end
    return result
end

