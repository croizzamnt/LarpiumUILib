function Window:_renderStatsOverlay(zIndex, alpha)
    local widget = self._statsOverlay
    if not widget or not widget.Visible then return end
    local now = os.clock()
    if now - (widget._lastUpdate or 0) >= widget.UpdateInterval then
        widget._lastUpdate = now
        widget._cache = {
            FPS = tostring(floor((self._fps or 0) + 0.5)),
            FrameTime = string.format("%.2f ms", self._frameTime or 0),
            Ping = readPing(),
            PlayerCount = tostring(#Players:GetPlayers()),
            DrawingObjects = tostring(#self._drawings),
        }
        for name, value in pairs(widget.Values) do widget._cache[name] = tostring(value) end
        for name, provider in pairs(widget.Providers) do
            if not provider.Running and now - provider.LastUpdate >= provider.Interval then
                provider.LastUpdate = now
                provider.Running = true
                task.spawn(function()
                    local ok, value = safeCall(provider.Callback, self, widget)
                    provider.Value = ok and tostring(value) or "Error"
                    provider.Running = false
                    widget._lastUpdate = 0
                end)
            end
            widget._cache[name] = provider.Value or "..."
        end
    end
    local rows = {}
    local builtInOrder = { "FPS", "FrameTime", "Ping", "PlayerCount", "DrawingObjects" }
    for _, name in ipairs(builtInOrder) do
        if widget.Metrics[name] ~= false then table.insert(rows, { Name = name, Value = widget._cache and widget._cache[name] or "..." }) end
    end
    local customNames = {}
    for name in pairs(widget.Values) do table.insert(customNames, name) end
    for name in pairs(widget.Providers) do if not hasValue(customNames, name) then table.insert(customNames, name) end end
    table.sort(customNames)
    for _, name in ipairs(customNames) do
        if not hasValue(builtInOrder, name) then
            table.insert(rows, { Name = name, Value = widget._cache and widget._cache[name] or "..." })
        end
    end
    local logCount = widget.ShowLogs and min(3, #widget.Logs) or 0
    local width, headerHeight, rowHeight = 238, 32, 22
    local height = headerHeight + #rows * rowHeight + (logCount > 0 and (8 + logCount * 20) or 6)
    local viewport = viewportSize()
    if not widget._positionReady then
        widget.Position = string.lower(widget.Anchor) == "topright" and vector(viewport.X - width - 14, 104) or vector(14, 104)
        widget._positionReady = true
    end
    widget.Position = vector(clamp(widget.Position.X, 0, viewport.X - width), clamp(widget.Position.Y, 0, viewport.Y - height))
    local bounds = rect(widget.Position.X, widget.Position.Y, width, height)
    widget.Bounds = bounds
    local background = namedDrawing(widget, "stats:background", "Square", { Filled = true })
    local border = namedDrawing(widget, "stats:border", "Square", { Filled = false })
    local header = namedDrawing(widget, "stats:header", "Square", { Filled = true })
    showSquare(background, bounds, self.Theme.Popup, alpha * 0.94, zIndex)
    showSquare(border, bounds, self.Theme.Border, alpha, zIndex + 1, false, 1)
    showSquare(header, rect(bounds.X, bounds.Y, bounds.W, headerHeight), self.Theme.Header, alpha, zIndex + 2)
    local title = namedDrawing(widget, "stats:title", "Text")
    showText(title, widget.Title, vector(bounds.X + 11, bounds.Y + 9), self.Theme.Text, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 4)
    local y = bounds.Y + headerHeight + 5
    for index, item in ipairs(rows) do
        local label = namedDrawing(widget, "stats:label:" .. index, "Text")
        local value = namedDrawing(widget, "stats:value:" .. index, "Text")
        showText(label, item.Name, vector(bounds.X + 11, y + 4), self.Theme.TextSecondary, self.Settings.SmallFontSize, self.Settings.Font, alpha, zIndex + 4)
        showText(value, item.Value, vector(bounds.X + bounds.W - estimateTextWidth(item.Value, self.Settings.SmallFontSize) - 11, y + 4), self.Theme.Accent, self.Settings.SmallFontSize, self.Settings.MonoFont, alpha, zIndex + 4)
        y = y + rowHeight
    end
    if logCount > 0 then
        local divider = namedDrawing(widget, "stats:divider", "Line")
        showLine(divider, vector(bounds.X + 9, y + 2), vector(bounds.X + bounds.W - 9, y + 2), self.Theme.BorderSoft, alpha, 1, zIndex + 4)
        y = y + 8
        local start = #widget.Logs - logCount + 1
        for visualIndex = 1, logCount do
            local entry = widget.Logs[start + visualIndex - 1]
            local token = notificationColors[string.lower(entry.Level)] or "Info"
            local drawing = namedDrawing(widget, "stats:log:" .. visualIndex, "Text")
            showText(drawing, trimText(entry.Time .. "  " .. entry.Message, width - 22, self.Settings.SmallFontSize), vector(bounds.X + 11, y + 3), self.Theme[token] or self.Theme.TextSecondary, self.Settings.SmallFontSize, self.Settings.Font, alpha, zIndex + 4)
            y = y + 20
        end
    end
    widget.HeaderRegion.Rect = rect(bounds.X, bounds.Y, bounds.W, headerHeight)
    widget.HeaderRegion.Z = zIndex + 20
    registerRegion(self, widget.HeaderRegion)
end

Library.NativeFonts = {
    UI = 0,
    System = 1,
    Plex = 2,
    Monospace = 3,
}
Library.CustomFonts = {}
Library.FontCacheFolder = "UILibSuprema/fonts"

function Library:LoadFont(url, name, fallback)
    name = tostring(name or "custom")
    fallback = fallback or self.NativeFonts.Plex
    local filepath = self.FontCacheFolder .. "/" .. name .. ".ttf"
    local fontObj
    local okCreate, obj = pcall(function() return Drawing.new("Font") end)
    if okCreate and obj then
        fontObj = obj
    else
        return fallback
    end
    local function tryApply(data)
        if not data or #data == 0 then return false end
        return pcall(function() fontObj.Data = data end)
    end
    if type(isfile) == "function" and isfile(filepath) then
        local ok, data = pcall(readfile, filepath)
        if ok and tryApply(data) then
            self.CustomFonts[name] = { Font = fontObj, Fallback = fallback, Url = url }
            return fontObj
        end
    end
    local okFetch, raw = pcall(function() return game:HttpGet(url) end)
    if okFetch and raw and #raw > 0 then
        pcall(function()
            if type(isfolder) == "function" and not isfolder(self.FontCacheFolder) then makefolder(self.FontCacheFolder) end
            if type(writefile) == "function" then writefile(filepath, raw) end
        end)
        local okRead, data = pcall(readfile, filepath)
        if okRead and tryApply(data) then
            self.CustomFonts[name] = { Font = fontObj, Fallback = fallback, Url = url }
            return fontObj
        end
        if tryApply(raw) then
            self.CustomFonts[name] = { Font = fontObj, Fallback = fallback, Url = url }
            return fontObj
        end
    end
    pcall(function() fontObj:Destroy() end)
    return fallback
end

function Library:LoadAllFonts(regularUrl, monoUrl)
    if regularUrl then
        local regularFont = self:LoadFont(regularUrl, "Inter-Regular", self.NativeFonts.Plex)
        self.Settings.Font = regularFont
        Library.Settings.Font = regularFont
    end
    if monoUrl then
        local monoFont = self:LoadFont(monoUrl, "Inter-Mono", self.NativeFonts.Monospace)
        self.Settings.MonoFont = monoFont
        Library.Settings.MonoFont = monoFont
    end
end

function Library:ResolveFont(font)
    if type(font) == "number" then
        return clamp(floor(tonumber(font) or 2), 0, 3)
    elseif type(font) == "string" then
        local native = self.NativeFonts[font] or self.NativeFonts[font:gsub("^%l", string.upper)]
        if native ~= nil then return native end
        local custom = self.CustomFonts[font]
        if custom then return custom.Fallback end
    elseif type(font) == "table" and font.Fallback ~= nil then
        return self:ResolveFont(font.Fallback)
    end
    return self.NativeFonts.Plex
end

function Library:ApplyFont(textDrawing, font)
    local resolved = self:ResolveFont(font)
    local custom = type(font) == "string" and self.CustomFonts[font] or (type(font) == "table" and font or nil)
    if type(isrenderobj) == "function" and not isrenderobj(textDrawing) then
        return false, "The target is not a live Drawing object."
    end
    if type(getrenderproperty) == "function" then
        local isText = pcall(getrenderproperty, textDrawing, "TextBounds")
        if not isText then return false, "ApplyFont accepts Drawing Text objects only." end
    end
    local ok, message
    if type(setrenderproperty) == "function" then
        ok, message = pcall(setrenderproperty, textDrawing, "Font", resolved)
    else
        ok, message = pcall(function() textDrawing.Font = resolved end)
    end
    return ok, ok and resolved or tostring(message), custom and custom.Limitation or nil
end

local function normalizePath(path)
    return tostring(path or ""):gsub("\\", "/"):gsub("/+", "/"):gsub("/$", "")
end

local function ensureFolder(path)
    path = normalizePath(path)
    if path == "" then return true end
    if type(isfolder) ~= "function" or type(makefolder) ~= "function" then
        return false, "Folder functions are unavailable."
    end
    local current = ""
    for segment in path:gmatch("[^/]+") do
        current = current == "" and segment or (current .. "/" .. segment)
        local ok, exists = pcall(isfolder, current)
        if not ok or not exists then
            local made, errorMessage = pcall(makefolder, current)
            if not made then return false, tostring(errorMessage) end
        end
    end
    return true
end

local function ensureParentFolder(path)
    local parent = normalizePath(path):match("^(.*)/[^/]+$")
    if not parent or parent == "" then return true end
    return ensureFolder(parent)
end

local function fileExists(path)
    if type(isfile) == "function" then
        local ok, result = pcall(isfile, path)
        return ok and result == true
    end
    if type(readfile) == "function" then
        return pcall(readfile, path)
    end
    return false
end

local function safeConfigName(name)
    name = tostring(name or ""):match("^%s*(.-)%s*$") or ""
    name = name:gsub("%.json$", "")
    if name == "" then return nil, "Configuration name cannot be empty." end
    if #name > 64 then return nil, "Configuration name is limited to 64 characters." end
    if name:find("..", 1, true) or name:find("/", 1, true) or name:find("\\", 1, true)
        or name:find(":", 1, true) or name:find("%c") then
        return nil, "Configuration name contains an unsafe character."
    end
    if not name:match("^[%w _%-]+$") then
        return nil, "Use letters, numbers, spaces, underscores, or hyphens."
    end
    return name
end

function Library:LoadFont(name, url, options)
    options = options or {}
    assert(type(name) == "string" and name:match("^[%w _%-]+$"), "Invalid font name")
    assert(type(url) == "string" and url:match("^https?://"), "Font URL must use HTTP or HTTPS")
    assert(type(writefile) == "function", "writefile is required to cache a custom font")
    local folder = normalizePath(options.Folder or "UILibSuprema/fonts")
    local urlWithoutQuery = url:match("^[^?]+") or url
    local extension = tostring(options.Extension or urlWithoutQuery:match("%.([%a%d]+)$") or "ttf"):lower()
    if extension ~= "ttf" and extension ~= "otf" then extension = "ttf" end
    local fileName = name:gsub("%s+", "_") .. "." .. extension
    local path = folder .. "/" .. fileName
    local ok, errorMessage = ensureFolder(folder)
    assert(ok, errorMessage)
    if options.Refresh == true or not fileExists(path) then
        local downloaded, body = pcall(function() return game:HttpGet(url) end)
        assert(downloaded and type(body) == "string" and #body > 0, "Unable to download custom font: " .. tostring(body))
        local written, writeError = pcall(writefile, path, body)
        assert(written, "Unable to cache custom font: " .. tostring(writeError))
    end
    local asset = nil
    if type(getcustomasset) == "function" then
        local assetOk, assetValue = pcall(getcustomasset, path)
        if assetOk then asset = assetValue end
    end
    local record = {
        Name = name,
        Path = path,
        Asset = asset,
        Fallback = self:ResolveFont(options.Fallback or "Plex"),
        NativeApplied = false,
        Limitation = "This Drawing specification only accepts native numeric font IDs 0-3.",
    }
    self.CustomFonts[name] = record
    return record
end

local readableRenderProperties = {
    Visible = true, ZIndex = true, Transparency = true, Color = true,
    From = true, To = true, Thickness = true, Text = true, TextBounds = true,
    Font = true, Size = true, Position = true, Center = true, Outline = true,
    OutlineColor = true, Data = true, Rounding = true, NumSides = true,
    Radius = true, Filled = true, PointA = true, PointB = true, PointC = true, PointD = true,
}

local writableRenderProperties = copy(readableRenderProperties)
writableRenderProperties.TextBounds = nil

local renderPropertyTypes = {
    Visible = "boolean", Center = "boolean", Outline = "boolean", Filled = "boolean",
    ZIndex = "number", Transparency = "number", Thickness = "number", Font = "number",
    Rounding = "number", NumSides = "number", Radius = "number",
    Text = "string", Data = "string",
    Color = "Color3", OutlineColor = "Color3",
    From = "Vector2", To = "Vector2", Position = "Vector2",
    PointA = "Vector2", PointB = "Vector2", PointC = "Vector2", PointD = "Vector2",
}

local function validRenderPropertyType(property, value)
    if property == "Size" then return type(value) == "number" or typeof(value) == "Vector2" end
    local expected = renderPropertyTypes[property]
    if expected == "Color3" or expected == "Vector2" then return typeof(value) == expected end
    return expected == nil or type(value) == expected
end

function Library:GetRenderProperty(drawing, property)
    assert(readableRenderProperties[property] == true, "Unsupported Drawing property: " .. tostring(property))
    if type(getrenderproperty) == "function" then
        return getrenderproperty(drawing, property)
    end
    return drawing[property]
end

function Library:SetRenderProperty(drawing, property, value)
    assert(writableRenderProperties[property] == true, "Unsupported or read-only Drawing property: " .. tostring(property))
    assert(validRenderPropertyType(property, value), "Invalid value type for Drawing property '" .. tostring(property) .. "'")
    if type(setrenderproperty) == "function" then
        return pcall(setrenderproperty, drawing, property, value)
    end
    return pcall(function() drawing[property] = value end)
end

function Library:IsRenderObject(value)
    if type(isrenderobj) == "function" then return isrenderobj(value) end
    return false
end

function Library:ClearRenderCache(confirmGlobalDestruction)
    if confirmGlobalDestruction ~= true then
        return false, "Refused: cleardrawcache destroys Drawing objects owned by other scripts."
    end
    if type(cleardrawcache) ~= "function" then return false, "cleardrawcache is unavailable." end
    self:Unload()
    cleardrawcache()
    return true
end

function Window:ExportConfig()
    local values = {}
    for flag, pending in pairs(self._pendingConfigValues) do
        if type(pending) == "table" and pending.__pendingSerialized then
            values[flag] = pending.Value
        else
            values[flag] = serializedValue(pending)
        end
    end
    for _, element in ipairs(self._elements) do
        if not element._destroyed then element:_applyPendingConfig() end
    end
    for flag, element in pairs(self._elementByFlag) do
        if not element._destroyed and not element.IgnoreConfig then
            values[flag] = element:Serialize()
        end
    end
    local widgets = {}
    if self._watermark then
        widgets.Watermark = serializedValue({
            Visible = self._watermark.Visible, Position = self._watermark.Position,
            Anchor = self._watermark.Anchor, Dynamic = self._watermark.Dynamic, Fields = self._watermark.Fields,
            Draggable = self._watermark.Draggable, FollowWindowVisibility = self._watermark.FollowWindowVisibility,
            UpdateInterval = self._watermark.UpdateInterval, Separator = self._watermark.Separator,
        })
    end
    if self._keybindList then
        widgets.KeybindList = serializedValue({
            Visible = self._keybindList.Visible, Position = self._keybindList.Position, Anchor = self._keybindList.Anchor,
            Draggable = self._keybindList.Draggable, FollowWindowVisibility = self._keybindList.FollowWindowVisibility,
            ShowInactive = self._keybindList.ShowInactive, ShowUnbound = self._keybindList.ShowUnbound,
            MaxVisibleRows = self._keybindList.MaxVisibleRows,
        })
    end
    if self._statsOverlay then
        widgets.StatsOverlay = serializedValue({
            Visible = self._statsOverlay.Visible, Position = self._statsOverlay.Position,
            Anchor = self._statsOverlay.Anchor, Metrics = self._statsOverlay.Metrics,
            Draggable = self._statsOverlay.Draggable, FollowWindowVisibility = self._statsOverlay.FollowWindowVisibility,
            UpdateInterval = self._statsOverlay.UpdateInterval, ShowLogs = self._statsOverlay.ShowLogs,
        })
    end
    return {
        Schema = 1,
        Library = "UILib Suprema",
        Version = Library.Version,
        WindowId = self.Id,
        SavedAt = os.time(),
        Layout = serializedValue({ Position = self._targetPosition, Size = self._targetSize }),
        Theme = serializedValue(self._themePatch),
        Settings = serializedValue({
            Animations = self.Settings.Animations,
            AnimationSpeed = self.Settings.AnimationSpeed,
            Easing = self.Settings.Easing,
            Font = self.Settings.Font,
            MonoFont = self.Settings.MonoFont,
            Radius = self.Settings.Radius,
            Opacity = self.Settings.Opacity,
            ToggleKey = self.Settings.ToggleKey,
        }),
        Widgets = widgets,
        Values = values,
    }
end

function Window:ImportConfig(data, silent)
    assert(type(data) == "table", "Configuration payload must be a table")
    if data.Schema ~= nil then
        assert(tonumber(data.Schema) == 1, "Unsupported configuration schema")
    end

    local function decodeTable(value, label)
        if value == nil then return nil end
        assert(type(value) == "table", label .. " must be a table")
        local decoded = deserializedValue(value)
        assert(type(decoded) == "table", label .. " must decode to a table")
        return decoded
    end

    local layout = decodeTable(data.Layout, "Configuration layout")
    local themePatch = decodeTable(data.Theme, "Configuration theme")
    local settingsPatch = decodeTable(data.Settings, "Configuration settings")
    local widgets = decodeTable(data.Widgets, "Configuration widgets")
    local values = data.Values or {}
    assert(type(values) == "table", "Configuration values must be a table")

    if layout then
        if layout.Size ~= nil then assert(typeof(layout.Size) == "Vector2", "Layout size must be Vector2") end
        if layout.Position ~= nil then assert(typeof(layout.Position) == "Vector2", "Layout position must be Vector2") end
    end
    if themePatch then themePatch = validatedThemePatch(themePatch, Library.Theme) end
    if settingsPatch then settingsPatch = validatedSettingsPatch(settingsPatch) end
    if widgets then
        for _, name in ipairs({ "Watermark", "KeybindList", "StatsOverlay" }) do
            assert(widgets[name] == nil or type(widgets[name]) == "table", name .. " settings must be a table")
        end
    end

    if layout then
        local viewport = viewportSize()
        if typeof(layout.Size) == "Vector2" then
            self._targetSize = vector(
                clamp(layout.Size.X, 580, max(580, viewport.X - 24)),
                clamp(layout.Size.Y, 420, max(420, viewport.Y - 24))
            )
        end
        if typeof(layout.Position) == "Vector2" then
            self._targetPosition = vector(
                clamp(layout.Position.X, -self._targetSize.X + 80, viewport.X - 80),
                clamp(layout.Position.Y, 0, viewport.Y - 42)
            )
        end
    end
    if themePatch then self:SetTheme(themePatch, true) end
    if settingsPatch then self:SetSettings(settingsPatch) end
    if widgets then
        if widgets.Watermark then self:SetWatermark(widgets.Watermark) end
        if widgets.KeybindList then self:SetKeybindList(widgets.KeybindList) end
        if widgets.StatsOverlay then self:SetStatsOverlay(widgets.StatsOverlay) end
    end
    local failures = {}
    for flag, rawValue in pairs(values) do
        local element = self._elementByFlag[flag]
        if element then
            local ok, message = pcall(function() element:Deserialize(rawValue, silent == true) end)
            if not ok then failures[flag] = tostring(message) end
        else
            self._pendingConfigValues[flag] = {
                __pendingSerialized = true,
                Value = rawValue,
                Silent = silent == true,
            }
        end
    end
    if self._syncConfigControls then self:_syncConfigControls() end
    return next(failures) == nil, failures
end

function ConfigManager:IsAvailable()
    return type(readfile) == "function" and type(writefile) == "function" and type(listfiles) == "function"
end

function ConfigManager:_path(name)
    local safeName, errorMessage = safeConfigName(name)
    if not safeName then return nil, errorMessage end
    return normalizePath(self.Folder) .. "/" .. safeName .. ".json", safeName
end

function ConfigManager:_error(message)
    self.LastError = tostring(message)
    return false, self.LastError
end

function ConfigManager:Refresh()
    if not self:IsAvailable() then
        self.Available = {}
        return self:_error("The executor does not expose the required file-system functions.")
    end
    local ok, errorMessage = ensureFolder(self.Folder)
    if not ok then return self:_error(errorMessage) end
    local listed, files = pcall(listfiles, normalizePath(self.Folder))
    if not listed or type(files) ~= "table" then return self:_error(files) end
    local names = {}
    for _, path in ipairs(files) do
        local normalized = normalizePath(path)
        local name = normalized:match("([^/]+)%.json$")
        if name then table.insert(names, name) end
    end
    table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
    self.Available = names
    if self.Selected and not hasValue(names, self.Selected) then self.Selected = nil end
    self.LastError = nil
    return true, names
end

function ConfigManager:Exists(name)
    local path = self:_path(name)
    return path ~= nil and fileExists(path)
end

function ConfigManager:Save(name, overwrite)
    if not self:IsAvailable() then return self:_error("File-system support is unavailable.") end
    local path, safeNameOrError = self:_path(name)
    if not path then return self:_error(safeNameOrError) end
    if overwrite == false and fileExists(path) then return self:_error("A configuration with that name already exists.") end
    local folderOk, folderError = ensureFolder(self.Folder)
    if not folderOk then return self:_error(folderError) end
    local encoded, payload = pcall(function() return HttpService:JSONEncode(self.Window:ExportConfig()) end)
    if not encoded then return self:_error(payload) end
    local written, writeError = pcall(writefile, path, payload)
    if not written then return self:_error(writeError) end
    self.Selected = safeNameOrError
    self:Refresh()
    return true, safeNameOrError
end

function ConfigManager:Create(name)
    return self:Save(name, false)
end

function ConfigManager:Load(name, silent)
    if not self:IsAvailable() then return self:_error("File-system support is unavailable.") end
    local path, safeNameOrError = self:_path(name)
    if not path then return self:_error(safeNameOrError) end
    local read, payload = pcall(readfile, path)
    if not read then return self:_error(payload) end
    local decoded, data = pcall(function() return HttpService:JSONDecode(payload) end)
    if not decoded or type(data) ~= "table" then return self:_error("Configuration JSON is invalid: " .. tostring(data)) end
    local importCall, imported, failures = pcall(self.Window.ImportConfig, self.Window, data, silent)
    if not importCall then
        return self:_error("Configuration import failed: " .. tostring(imported))
    end
    self.Selected = safeNameOrError
    if not imported then
        self.LastError = "Some values could not be restored."
        return false, self.LastError, failures
    end
    self.LastError = nil
    return true, safeNameOrError
end

function ConfigManager:Delete(name)
    if type(delfile) ~= "function" then return self:_error("delfile is unavailable.") end
    local path, safeNameOrError = self:_path(name)
    if not path then return self:_error(safeNameOrError) end
    if not fileExists(path) then return self:_error("Configuration does not exist.") end
    local deleted, deleteError = pcall(delfile, path)
    if not deleted then return self:_error(deleteError) end
    if self:GetAutoLoad() == safeNameOrError then self:SetAutoLoad(nil) end
    if self.Selected == safeNameOrError then self.Selected = nil end
    self:Refresh()
    return true, safeNameOrError
end

function ConfigManager:_readAutoMap()
    if type(readfile) ~= "function" or not fileExists(self.AutoLoadFile) then return {} end
    local ok, payload = pcall(readfile, self.AutoLoadFile)
    if not ok then return {} end
    local decoded, data = pcall(function() return HttpService:JSONDecode(payload) end)
    return decoded and type(data) == "table" and data or {}
end

function ConfigManager:GetAutoLoad()
    return self:_readAutoMap()[self.Window.Id]
end

function ConfigManager:SetAutoLoad(name)
    if type(writefile) ~= "function" then return self:_error("writefile is unavailable.") end
    local data = self:_readAutoMap()
    if name == nil or name == false or name == "" then
        data[self.Window.Id] = nil
    else
        local path, safeNameOrError = self:_path(name)
        if not path then return self:_error(safeNameOrError) end
        data[self.Window.Id] = safeNameOrError
    end
    local folderOk, folderError = ensureParentFolder(self.AutoLoadFile)
    if not folderOk then return self:_error(folderError) end
    local encoded, payload = pcall(function() return HttpService:JSONEncode(data) end)
    if not encoded then return self:_error(payload) end
    local written, writeError = pcall(writefile, self.AutoLoadFile, payload)
    if not written then return self:_error(writeError) end
    return true, data[self.Window.Id]
end

function ConfigManager:LoadAuto()
    local name = self:GetAutoLoad()
    if not name then return false, "No auto-load configuration is assigned." end
    return self:Load(name)
end

function Window:_buildConfigTab()
    if self._configTab then return self._configTab end
    self._configControls = self._configControls or { WatermarkFields = {} }
    local controls = self._configControls
    local tab = self:AddTab({ Name = "Settings", Icon = "settings", Internal = true })
    self._configTab = tab
    local configs = tab:AddSection({
        Name = "Configuration Manager",
        Icon = "folder",
        FullWidth = false,
        Side = "Left",
    })
    local available = self.Config:IsAvailable()
    local status = configs:AddLabel({
        Name = available and "Storage ready" or "Storage unavailable",
        Description = available and "Profiles are stored as JSON files." or "Required file-system functions were not detected.",
        Tooltip = "The manager never crashes when an executor omits file-system APIs.",
    })
    local nameInput = configs:AddTextBox({
        Name = "Profile name", Placeholder = "Type a safe name...", MaxLength = 64, IgnoreConfig = true,
    })
    local profileList = configs:AddDropdown({
        Name = "Saved profiles", Options = {}, MaxVisible = 7, IgnoreConfig = true,
        Callback = function(value) self.Config.Selected = value end,
    })
    local function updateList(notifyOnFailure)
        local ok, result = self.Config:Refresh()
        if ok then
            profileList:SetOptions(result, false)
            if self.Config.Selected then profileList:Set(self.Config.Selected, true) end
            status:SetText("Storage ready", tostring(#result) .. " profile(s) found.")
            if self._syncConfigControls then self:_syncConfigControls(true) end
        elseif notifyOnFailure then
            self:Notify({ Type = "Error", Title = "Configuration error", Description = tostring(result) })
        end
        return ok, result
    end
    configs:AddButton({
        Name = "Refresh profiles",
        Icon = "refresh",
        Callback = function() updateList(true) end,
    })
    configs:AddButton({
        Name = "Create profile",
        Icon = "plus",
        Callback = function()
            local ok, result = self.Config:Create(nameInput:Get())
            self:Notify({ Type = ok and "Success" or "Error", Title = ok and "Profile created" or "Create failed", Description = tostring(result) })
            if ok then updateList(false); profileList:Set(result, true) end
        end,
    })
    configs:AddButton({
        Name = "Save selected",
        Icon = "save",
        Callback = function()
            local selected = self.Config.Selected or profileList:Get()
            local ok, result = self.Config:Save(selected, true)
            self:Notify({ Type = ok and "Success" or "Error", Title = ok and "Profile saved" or "Save failed", Description = tostring(result) })
        end,
    })
    configs:AddButton({
        Name = "Load selected",
        Icon = "download",
        Callback = function()
            local selected = self.Config.Selected or profileList:Get()
            local ok, result = self.Config:Load(selected)
            self:Notify({ Type = ok and "Success" or "Error", Title = ok and "Profile loaded" or "Load failed", Description = tostring(result) })
        end,
    })
    configs:AddButton({
        Name = "Delete selected",
        Icon = "trash",
        Callback = function()
            local selected = self.Config.Selected or profileList:Get()
            self:Prompt({
                Title = "Delete profile", Description = "This permanently deletes '" .. tostring(selected or "") .. "'.",
                ConfirmText = "Delete", Destructive = true,
                OnConfirm = function()
                    local ok, result = self.Config:Delete(selected)
                    self:Notify({ Type = ok and "Success" or "Error", Title = ok and "Profile deleted" or "Delete failed", Description = tostring(result) })
                    if ok then updateList(false) end
                end,
            })
        end,
    })
    controls.AutoLoad = configs:AddToggle({
        Name = "Auto-load selected", Default = self.Config:GetAutoLoad() ~= nil, IgnoreConfig = true,
        Callback = function(enabled, toggle)
            local selected = self.Config.Selected or profileList:Get()
            if enabled and not selected then
                toggle:Set(false, true)
                self:Notify({ Type = "Warning", Title = "No profile selected", Description = "Select or create a profile before enabling auto-load." })
                return
            end
            local ok, result = self.Config:SetAutoLoad(enabled and selected or nil)
            if not ok then self:Notify({ Type = "Error", Title = "Auto-load failed", Description = tostring(result) }) end
        end,
    })

    local appearance = tab:AddSection({
        Name = "Appearance and Motion",
        Icon = "palette",
        Side = "Right",
    })
    controls.Animations = appearance:AddToggle({
        Name = "Animations", Default = self.Settings.Animations, IgnoreConfig = true,
        Callback = function(value) self.Settings.Animations = value end,
    })
    controls.AnimationSpeed = appearance:AddSlider({
        Name = "Animation speed", Min = 4, Max = 30, Step = 1, Default = self.Settings.AnimationSpeed, IgnoreConfig = true,
        Callback = function(value) self.Settings.AnimationSpeed = value end,
    })
    controls.Radius = appearance:AddSlider({
        Name = "Corner radius", Min = 0, Max = 12, Step = 1, Default = self.Settings.Radius, Suffix = " px", IgnoreConfig = true,
        Callback = function(value) self.Settings.Radius = value end,
    })
    controls.Opacity = appearance:AddSlider({
        Name = "Interface opacity", Min = 0.55, Max = 1, Step = 0.05, Default = self.Settings.Opacity, IgnoreConfig = true,
        Callback = function(value) self.Settings.Opacity = value end,
    })
    controls.ToggleKey = appearance:AddKeybind({
        Name = "Menu toggle key", Default = self.Settings.ToggleKey, Mode = "Toggle", IgnoreConfig = true,
        OnKeyChanged = function(key) self.Settings.ToggleKey = key end,
    })
    local themeOptions = {}
    for name, _ in pairs(Library.Themes) do table.insert(themeOptions, name) end
    table.sort(themeOptions)
    controls.ThemeDropdown = appearance:AddDropdown({
        Name = "Active theme", Options = themeOptions, Default = "Suprema", IgnoreConfig = true,
        Callback = function(value)
            Library:SetTheme(value)
            if self._syncConfigControls then self:_syncConfigControls() end
        end,
    })
    appearance:AddButton({
        Name = "Refresh saved themes",
        Icon = "refresh",
        Callback = function()
            Library:LoadSavedThemes()
            local options = {}
            for name, _ in pairs(Library.Themes) do table.insert(options, name) end
            for name, _ in pairs(Library.SavedThemes) do
                if not Library.Themes[name] then
                    Library.Themes[name] = Library.SavedThemes[name]
                end
                table.insert(options, name)
            end
            table.sort(options)
            controls.ThemeDropdown:SetOptions(options, true)
        end,
    })
    appearance:AddButton({
        Name = "Open Theme Editor",
        Icon = "palette",
        Callback = function()
            self:OpenThemeEditor()
        end,
    })

    local overlays = tab:AddSection({
        Name = "Floating Overlays",
        Icon = "layers",
        FullWidth = true,
    })
    controls.Watermark = overlays:AddToggle({
        Name = "Dynamic watermark", Default = false, IgnoreConfig = true,
        Callback = function(value)
            local widget = self:SetWatermark({ Dynamic = true, Visible = value, Draggable = true })
            widget.Visible = value
        end,
    })
    local watermarkFields = {
        { Name = "Show username", Field = "Username", Default = true },
        { Name = "Show game name", Field = "GameName", Default = true },
        { Name = "Show game ID", Field = "GameId", Default = false },
        { Name = "Show place ID", Field = "PlaceId", Default = false },
        { Name = "Show FPS", Field = "FPS", Default = true },
        { Name = "Show ping", Field = "Ping", Default = true },
        { Name = "Show player count", Field = "PlayerCount", Default = true },
        { Name = "Show clock", Field = "Clock", Default = true },
    }
    for _, definition in ipairs(watermarkFields) do
        local fieldName = definition.Field
        controls.WatermarkFields[fieldName] = overlays:AddCheckbox({
            Name = definition.Name, Default = definition.Default, IgnoreConfig = true,
            Callback = function(value)
                self:SetWatermark({ Dynamic = true, Visible = self._watermark and self._watermark.Visible or false })
                    :SetFieldVisible(fieldName, value)
            end,
        })
    end
    controls.KeybindList = overlays:AddToggle({
        Name = "Keybind list", Default = false, IgnoreConfig = true,
        Callback = function(value) self:SetKeybindList({ Visible = value }) end,
    })
    updateList(false)
    self:_syncConfigControls(true)
    return tab
end

function Window:_syncConfigControls(syncStorage)
    local controls = self._configControls
    if not controls then return end
    if controls.Animations then controls.Animations:Set(self.Settings.Animations, true) end
    if controls.AnimationSpeed then controls.AnimationSpeed:Set(self.Settings.AnimationSpeed, true) end
    if controls.Radius then controls.Radius:Set(self.Settings.Radius, true) end
    if controls.Opacity then controls.Opacity:Set(self.Settings.Opacity, true) end
    if controls.ToggleKey then controls.ToggleKey:SetKey(self.Settings.ToggleKey, true) end
    if controls.AutoLoad and syncStorage then controls.AutoLoad:Set(self.Config:GetAutoLoad() ~= nil, true) end
    if controls.Watermark then controls.Watermark:Set(self._watermark and self._watermark.Visible or false, true) end
