function Section:AddKeybind(options)
    options = options or {}
    local defaultKey = options.Default or options.Key or Enum.KeyCode.Unknown
    if type(defaultKey) == "string" then defaultKey = keyFromName(defaultKey) or Enum.KeyCode.Unknown end
    local element = makeElement(self, "Keybind", options, defaultKey, 46)
    element.Mode = tostring(options.Mode or "Toggle")
    element.Active = string.lower(element.Mode) == "always"
    element.ShowInList = options.ShowInList ~= false
    element._usesHotkey = true
    table.insert(self._window._hotkeys, element)
    function element:SetKey(key, silent)
        if type(key) == "string" then key = keyFromName(key) end
        if typeof(key) ~= "EnumItem" then key = nil end
        if self._holding then
            self._holding = false
            self.Active = false
            if not silent then safeCall(self.Callback, false, self.Value, self) end
        end
        self.Value = key or Enum.KeyCode.Unknown
        if self.Flag then self._window.Flags[self.Flag] = self.Value end
        if not silent then safeCall(options.OnKeyChanged, self.Value, self) end
        return self
    end
    function element:Set(key, silent)
        return self:SetKey(key, silent)
    end
    function element:SetValue(key, silent)
        return self:SetKey(key, silent)
    end
    function element:SetMode(mode, silent)
        local normalized = string.lower(tostring(mode or "Toggle"))
        if normalized ~= "hold" and normalized ~= "always" then normalized = "toggle" end
        local wasActive = self.Active
        self.Mode = normalized == "hold" and "Hold" or (normalized == "always" and "Always" or "Toggle")
        self._holding = false
        self.Active = normalized == "always"
        if wasActive ~= self.Active and not silent then safeCall(self.Callback, self.Active, self.Value, self) end
        return self
    end
    function element:_cycleMode()
        self:SetMode(string.lower(self.Mode) == "hold" and "Toggle" or "Hold")
    end
    function element:_onSecondaryClick()
        self:_cycleMode()
    end
    function element:_hotkeyBegan(input, gameProcessed)
        if self.Disabled or gameProcessed or self._window._capturingKey == self or not inputMatchesKey(input, self.Value) then return false end
        local mode = string.lower(self.Mode)
        if mode == "hold" then
            self.Active = true
            self._holding = true
        elseif mode == "always" then
            self.Active = true
        else
            self.Active = not self.Active
        end
        safeCall(self.Callback, self.Active, self.Value, self)
        return true
    end
    function element:_hotkeyEnded(input)
        if self._holding and inputMatchesKey(input, self.Value) then
            self._holding = false
            self.Active = false
            safeCall(self.Callback, false, self.Value, self)
        end
    end
    function element:_onClick(position)
        if self._modeRect and pointIn(position, self._modeRect) then
            self:_cycleMode()
        else
            self._window:_clearFocus(true)
            self._window._capturingKey = self
        end
    end
    function element:Serialize()
        return serializedValue({ Key = self.Value, Mode = self.Mode, ShowInList = self.ShowInList })
    end
    function element:Deserialize(value, silent)
        value = deserializedValue(value)
        if type(value) == "table" then
            self:SetMode(value.Mode or self.Mode, silent)
            if value.ShowInList ~= nil then self.ShowInList = value.ShowInList == true end
            return self:SetKey(value.Key, silent)
        end
        return self:SetKey(value, silent)
    end
    function element:_render(context, targetRect)
        if not fullyInsideVertical(targetRect, context.Clip) then return end
        local capturing = self._window._capturingKey == self
        self:_card(context, targetRect, capturing or self.Active)
        self:_label(context, targetRect, 168)
        local text = capturing and "Press a key..." or enumName(self.Value)
        local width = clamp(estimateTextWidth(text, context.Settings.SmallFontSize) + 18, 50, 118)
        local modeText = string.lower(self.Mode) == "hold" and "Hold" or (string.lower(self.Mode) == "always" and "Always" or "Toggle")
        local modeWidth = estimateTextWidth(modeText, context.Settings.SmallFontSize) + 16
        self._modeRect = rect(targetRect.X + targetRect.W - modeWidth - 12, targetRect.Y + floor((targetRect.H - 26) / 2), modeWidth, 26)
        local modeHovered = pointIn(Library._mouse, self._modeRect)
        local modeBackground = self:_drawing("keybind:modeBackground", "Square", { Filled = true })
        showSquare(modeBackground, self._modeRect, modeHovered and context.Theme.AccentMuted or context.Theme.CardHover, context.Alpha, context.Z + 14)
        local modeDrawing = self:_drawing("keybind:modeText", "Text")
        showText(modeDrawing, modeText, vector(self._modeRect.X + self._modeRect.W / 2, self._modeRect.Y + 7), modeHovered and context.Theme.Accent or context.Theme.TextSecondary, context.Settings.SmallFontSize, context.Settings.Font, context.Alpha, context.Z + 17, true)
        local keyRect = rect(self._modeRect.X - width - 6, targetRect.Y + floor((targetRect.H - 26) / 2), width, 26)
        local keyBackground = self:_drawing("keybind:background", "Square", { Filled = true })
        local keyBorder = self:_drawing("keybind:border", "Square", { Filled = false })
        showSquare(keyBackground, keyRect, capturing and context.Theme.AccentMuted or context.Theme.Input, context.Alpha, context.Z + 14)
        showSquare(keyBorder, keyRect, capturing and context.Theme.Accent or context.Theme.BorderSoft, context.Alpha, context.Z + 15, false, 1)
        local keyText = self:_drawing("keybind:text", "Text")
        showText(keyText, text, vector(keyRect.X + keyRect.W / 2, keyRect.Y + 7), capturing and context.Theme.Accent or context.Theme.TextSecondary, context.Settings.SmallFontSize, context.Settings.Font, context.Alpha, context.Z + 17, true)
        self:_registerMain(context, targetRect)
    end
    if element.Flag then self._window.Flags[element.Flag] = element.Value end
    return element
end

