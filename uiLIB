local function validatedThemePatch(patch, reference)
    assert(type(patch or {}) == "table", "Theme patch must be a table")
    local result = {}
    reference = reference or Library.DefaultTheme
    for key, value in pairs(patch or {}) do
        if typeof(reference[key]) == "Color3" then
            assert(typeof(value) == "Color3", "Theme token '" .. tostring(key) .. "' must be Color3")
        end
        result[key] = value
    end
    return result
end

local function validatedSettingsPatch(patch)
    assert(type(patch or {}) == "table", "Settings patch must be a table")
    local result = copy(patch or {})
    if result.Animations ~= nil then result.Animations = result.Animations == true end
    if result.AnimationSpeed ~= nil then result.AnimationSpeed = max(0.01, assert(tonumber(result.AnimationSpeed), "AnimationSpeed must be numeric")) end
    if result.Radius ~= nil then result.Radius = max(0, assert(tonumber(result.Radius), "Radius must be numeric")) end
    if result.BorderThickness ~= nil then result.BorderThickness = max(0.5, assert(tonumber(result.BorderThickness), "BorderThickness must be numeric")) end
    if result.Opacity ~= nil then result.Opacity = clamp(assert(tonumber(result.Opacity), "Opacity must be numeric"), 0, 1) end
    if result.Padding ~= nil then result.Padding = max(0, assert(tonumber(result.Padding), "Padding must be numeric")) end
    if result.ElementGap ~= nil then result.ElementGap = max(0, assert(tonumber(result.ElementGap), "ElementGap must be numeric")) end
    if result.SectionGap ~= nil then result.SectionGap = max(0, assert(tonumber(result.SectionGap), "SectionGap must be numeric")) end
    if result.SidebarWidth ~= nil then result.SidebarWidth = max(56, assert(tonumber(result.SidebarWidth), "SidebarWidth must be numeric")) end
    if result.HeaderHeight ~= nil then result.HeaderHeight = max(40, assert(tonumber(result.HeaderHeight), "HeaderHeight must be numeric")) end
    if result.Font ~= nil then result.Font = Library:ResolveFont(result.Font) end
    if result.MonoFont ~= nil then result.MonoFont = Library:ResolveFont(result.MonoFont) end
    return result
end

local function newDrawing(owner, kind, properties)
    assert(DrawingAPI and DrawingAPI.new, "UILib Suprema: Drawing API is unavailable in this executor")
    assert(kind == "Line" or kind == "Text" or kind == "Image" or kind == "Circle"
        or kind == "Square" or kind == "Quad" or kind == "Triangle", "Unsupported Drawing object type: " .. tostring(kind))
    local drawing = DrawingAPI.new(kind)
    drawing.Visible = false
    for key, value in pairs(properties or {}) do
        pcall(function()
            drawing[key] = value
        end)
    end
    table.insert(owner._drawings, drawing)
    return drawing
end

local function setDrawing(drawing, properties)
    for key, value in pairs(properties) do
        drawing[key] = value
    end
    drawing.Visible = properties.Visible ~= false
end

local function hideDrawing(drawing)
    if drawing then
        drawing.Visible = false
    end
end

local function removeDrawing(drawing)
    if drawing then
        pcall(function()
            drawing:Destroy()
        end)
    end
end

local function namedDrawing(owner, key, kind, defaults)
    local drawing = owner._namedDrawings[key]
    if not drawing then
        drawing = newDrawing(owner._window or owner, kind, defaults)
        owner._namedDrawings[key] = drawing
    end
    return drawing
end

function RoundRect.new(owner, prefix)
    local self = setmetatable({
        Owner = owner,
        Prefix = prefix,
        Parts = {},
    }, RoundRect)
    self.Parts.Center = newDrawing(owner, "Square", { Filled = true })
    self.Parts.Middle = newDrawing(owner, "Square", { Filled = true })
    for index = 1, 4 do
        self.Parts[index] = newDrawing(owner, "Circle", {
            Filled = true,
            NumSides = 20,
        })
    end
    return self
end

function RoundRect:Set(position, size, radius, color, transparency, zIndex, visible)
    visible = visible ~= false and size.X > 0 and size.Y > 0
    radius = clamp(radius or 0, 0, min(size.X, size.Y) / 2)
    local common = {
        Color = color,
        Transparency = transparency,
        ZIndex = zIndex,
        Visible = visible,
    }
    if radius < 1 then
        setDrawing(self.Parts.Center, {
            Position = position,
            Size = size,
            Color = color,
            Transparency = transparency,
            ZIndex = zIndex,
            Filled = true,
            Visible = visible,
        })
        hideDrawing(self.Parts.Middle)
        for index = 1, 4 do
            hideDrawing(self.Parts[index])
        end
        return
    end
    setDrawing(self.Parts.Center, {
        Position = position + vector(radius, 0),
        Size = vector(max(0, size.X - radius * 2), size.Y),
        Filled = true,
        Color = common.Color,
        Transparency = common.Transparency,
        ZIndex = common.ZIndex,
        Visible = common.Visible,
    })
    setDrawing(self.Parts.Middle, {
        Position = position + vector(0, radius),
        Size = vector(size.X, max(0, size.Y - radius * 2)),
        Filled = true,
        Color = common.Color,
        Transparency = common.Transparency,
        ZIndex = common.ZIndex,
        Visible = common.Visible,
    })
    local centers = {
        position + vector(radius, radius),
        position + vector(size.X - radius, radius),
        position + vector(radius, size.Y - radius),
        position + vector(size.X - radius, size.Y - radius),
    }
    for index = 1, 4 do
        setDrawing(self.Parts[index], {
            Position = centers[index],
            Radius = radius,
            Filled = true,
            NumSides = 20,
            Color = common.Color,
            Transparency = common.Transparency,
            ZIndex = common.ZIndex,
            Visible = common.Visible,
        })
    end
end

function RoundRect:Hide()
    hideDrawing(self.Parts.Center)
    hideDrawing(self.Parts.Middle)
    for index = 1, 4 do
        hideDrawing(self.Parts[index])
    end
end

local function showSquare(drawing, targetRect, color, alpha, zIndex, filled, thickness)
    setDrawing(drawing, {
        Position = vector(targetRect.X, targetRect.Y),
        Size = vector(max(0, targetRect.W), max(0, targetRect.H)),
        Color = color,
        Transparency = clamp(alpha, 0, 1),
        ZIndex = zIndex,
        Filled = filled ~= false,
        Thickness = thickness or 1,
        Visible = targetRect.W > 0 and targetRect.H > 0 and alpha > 0.001,
    })
end

local function showText(drawing, text, position, color, size, font, alpha, zIndex, centered, outline)
    setDrawing(drawing, {
        Text = tostring(text or ""),
        Position = position,
        Color = color,
        Size = size,
        Font = Library:ResolveFont(font),
        Transparency = clamp(alpha, 0, 1),
        ZIndex = zIndex,
        Center = centered == true,
        Outline = true,
        OutlineColor = Color3.fromRGB(0, 0, 0),
        Visible = alpha > 0.001,
    })
end

local function showLine(drawing, from, to, color, alpha, thickness, zIndex)
    setDrawing(drawing, {
        From = from,
        To = to,
        Color = color,
        Transparency = clamp(alpha, 0, 1),
        Thickness = thickness or 1,
        ZIndex = zIndex,
        Visible = alpha > 0.001,
    })
end

local function estimateTextWidth(text, size)
    return #tostring(text or "") * size * 0.56
end

local function trimText(text, maxWidth, size)
    text = tostring(text or "")
    if estimateTextWidth(text, size) <= maxWidth then
        return text
    end
    local maximum = max(1, floor(maxWidth / (size * 0.56)) - 1)
    return text:sub(1, maximum) .. "…"
end

local function renderIcon(owner, prefix, specification, position, size, color, alpha, zIndex)
    if not specification then
        return 0
    end
    local resolved = type(specification) == "string" and Library.Icons[specification] or specification
    if type(resolved) == "table" and type(resolved.Data) == "string" then
        local image = namedDrawing(owner, prefix .. ":image", "Image")
        image.Data = resolved.Data
        image.Position = position
        image.Size = vector(size, size)
        image.Rounding = tonumber(resolved.Rounding) or 0
        image.Transparency = alpha
        image.ZIndex = zIndex
        image.Visible = true
        return size
    elseif type(resolved) == "table" and resolved.Lines then
        for index, points in ipairs(resolved.Lines) do
            local line = namedDrawing(owner, prefix .. ":line:" .. index, "Line")
            showLine(
                line,
                position + vector(points[1] * size, points[2] * size),
                position + vector(points[3] * size, points[4] * size),
                color,
                alpha,
                points[5] or 1.5,
                zIndex
            )
        end
        return size
    end
    local label = type(resolved) == "table" and resolved.Text or tostring(resolved or specification)
    local text = namedDrawing(owner, prefix .. ":text", "Text")
    showText(text, label, position + vector(size / 2, 0), color, size, owner._window.Settings.Font, alpha, zIndex, true)
    return size
end

local function registerRegion(window, region)
    region._order = #window._regions + 1
    table.insert(window._regions, region)
end

local function topRegionAt(window, position)
    local selected = nil
    for _, region in ipairs(window._regions) do
        if region.Enabled ~= false and pointIn(position, region.Rect) then
            if not selected or region.Z > selected.Z or (region.Z == selected.Z and region._order > selected._order) then
                selected = region
            end
        end
    end
    return selected
end

local function serializedValue(value)
    local kind = typeof(value)
    if kind == "Color3" then
        return { __type = "Color3", Hex = colorToHex(value) }
    elseif kind == "EnumItem" then
        return { __type = "EnumItem", EnumType = tostring(value.EnumType), Name = value.Name }
    elseif kind == "Vector2" then
        return { __type = "Vector2", X = value.X, Y = value.Y }
    elseif type(value) == "table" then
        local result = {}
        for key, item in pairs(value) do
            result[key] = serializedValue(item)
        end
        return result
    end
    return value
end

local function deserializedValue(value)
    if type(value) ~= "table" then
        return value
    end
    if value.__type == "Color3" then
        return colorFromHex(value.Hex) or Color3.new(1, 1, 1)
    elseif value.__type == "EnumItem" then
        local enumTypeName = tostring(value.EnumType or ""):match("Enum%.(.+)")
        local enumType = enumTypeName and Enum[enumTypeName]
        return enumType and enumType[value.Name] or nil
    elseif value.__type == "Vector2" then
        return vector(value.X or 0, value.Y or 0)
    end
    local result = {}
    for key, item in pairs(value) do
        result[key] = deserializedValue(item)
    end
    return result
end

function Library:GetCapabilities()
    return {
        Drawing = DrawingAPI ~= nil and type(DrawingAPI.new) == "function",
        FileSystem = type(readfile) == "function"
            and type(writefile) == "function"
            and type(listfiles) == "function",
        DeleteFile = type(delfile) == "function",
        Folders = type(isfolder) == "function" and type(makefolder) == "function",
        Clipboard = type(setclipboard) == "function",
        Http = game ~= nil and type(game.HttpGet) == "function",
        CustomAsset = type(getcustomasset) == "function",
        RenderProperties = type(getrenderproperty) == "function" and type(setrenderproperty) == "function",
        RenderObjectCheck = type(isrenderobj) == "function",
        ClearRenderCache = type(cleardrawcache) == "function",
    }
end

function Library:RegisterIcon(name, descriptor)
    assert(type(name) == "string" and name ~= "", "RegisterIcon requires a name")
    assert(type(descriptor) == "table" or type(descriptor) == "string", "Invalid icon descriptor")
    self.Icons[name] = descriptor
    return self
end

function Library:_capturePointer(window, onMove, onEnd)
    self._pointerCapture = {
        Window = window,
        Move = onMove,
        Ended = onEnd,
    }
end

function Library:_topWindowAt(position, allowOutside)
    local selected = nil
    for _, window in ipairs(self.Windows) do
        local independentVisible = (window._watermark and window._watermark.Visible and not window._watermark.FollowWindowVisibility)
            or (window._keybindList and window._keybindList.Visible and not window._keybindList.FollowWindowVisibility)
            or (window._statsOverlay and window._statsOverlay.Visible and not window._statsOverlay.FollowWindowVisibility)
        if not window._destroyed and (window._alpha > 0.02 or independentVisible) then
            local windowRect = rect(window._position.X, window._position.Y, window._size.X, window._size.Y)
            local isCandidate = (window._alpha > 0.02 and pointIn(position, windowRect))
                or (allowOutside and topRegionAt(window, position) ~= nil)
            if isCandidate and (not selected or window.DisplayOrder > selected.DisplayOrder) then
                selected = window
            end
        end
    end
    return selected
end

function Library:_focusedWindow()
    local selected = nil
    for _, window in ipairs(self.Windows) do
        if not window._destroyed and window.Visible and (window._focus or window._capturingKey) then
            if not selected or window.DisplayOrder > selected.DisplayOrder then
                selected = window
            end
        end
    end
    return selected
end

function Library:_dispatchGlobalInputBegan(input, gameProcessed)
    local windows = shallowArrayCopy(self.Windows)
    table.sort(windows, function(a, b)
        return a.DisplayOrder > b.DisplayOrder
    end)
    for _, window in ipairs(windows) do
        if window:_handleGlobalInputBegan(input, gameProcessed) then return true end
    end
    return false
end

function Library:_inputBegan(input, gameProcessed)
    if self._destroyed then
        return
    end
    local inputType = input.UserInputType
    local isKeyboard = inputType == Enum.UserInputType.Keyboard
    local isPointer = inputType == Enum.UserInputType.MouseButton1
        or inputType == Enum.UserInputType.MouseButton2
        or inputType == Enum.UserInputType.MouseButton3
        or inputType == Enum.UserInputType.Touch

    if isKeyboard or isPointer then
        local focused = self:_focusedWindow()
        if focused and focused:_handleFocusedInput(input) then
            return
        end
    end

    if isKeyboard then
        self:_dispatchGlobalInputBegan(input, gameProcessed)
        return
    end

    if not isPointer then
        return
    end
    self._mouse = pointerPosition(input)
    local window = self:_topWindowAt(self._mouse, true)
    if not window then
        if inputType ~= Enum.UserInputType.Touch then self:_dispatchGlobalInputBegan(input, gameProcessed) end
        return
    end
    if window._overlay and window._overlay.Rect and not pointIn(self._mouse, window._overlay.Rect)
        and (inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch) then
        window._overlay = nil
        window:_clearFocus(true)
        return
    end
    local region = topRegionAt(window, self._mouse)
    if not region and not pointIn(self._mouse, rect(window._position.X, window._position.Y, window._size.X, window._size.Y)) then
        if inputType ~= Enum.UserInputType.Touch then self:_dispatchGlobalInputBegan(input, gameProcessed) end
        return
    end
    if region then
        window:BringToFront()
        window._pressedRegion = region
        if region.OnBegan then
            safeCall(region.OnBegan, input, self._mouse, region)
        end
    elseif pointIn(self._mouse, rect(window._position.X, window._position.Y, window._size.X, window._size.Y)) then
        window:BringToFront()
        window._overlay = nil
        window:_clearFocus(true)
    end
end

function Library:_inputChanged(input)
    if self._destroyed then
        return
    end
    local inputType = input.UserInputType
    if inputType == Enum.UserInputType.MouseMovement or inputType == Enum.UserInputType.Touch then
        self._mouse = pointerPosition(input)
        local capture = self._pointerCapture
        if capture and capture.Move then
            safeCall(capture.Move, self._mouse, input)
        end
    elseif inputType == Enum.UserInputType.MouseWheel then
        self._mouse = UserInputService:GetMouseLocation()
        local window = self:_topWindowAt(self._mouse, true)
        if window then
            local region = topRegionAt(window, self._mouse)
            while region and not region.OnWheel and region.ParentRegion do
                region = region.ParentRegion
            end
            if region and region.OnWheel then
                safeCall(region.OnWheel, input.Position.Z, self._mouse)
            elseif pointIn(self._mouse, window._contentClip or rect(0, 0, 0, 0)) then
                window:_scrollActiveTab(input.Position.Z)
            end
        end
    end
end

function Library:_inputEnded(input)
    if self._destroyed then
        return
    end
    local capture = self._pointerCapture
    local isPointerEnd = input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    if capture and isPointerEnd then
        if capture.Ended then
            safeCall(capture.Ended, pointerPosition(input), input)
        end
        self._pointerCapture = nil
    end
    for _, window in ipairs(self.Windows) do
        window:_handleGlobalInputEnded(input)
        window._pressedRegion = nil
    end
end

function Library:_render(deltaTime)
    if self._destroyed then
        return
    end
    self._mouse = UserInputService:GetMouseLocation()
    local windows = shallowArrayCopy(self.Windows)
    table.sort(windows, function(a, b)
        return a.DisplayOrder < b.DisplayOrder
    end)
    for _, window in ipairs(windows) do
        if not window._destroyed then
            local ok, message = xpcall(function()
                window:_render(deltaTime)
            end, function(errorMessage)
                return debug.traceback(tostring(errorMessage), 2)
            end)
            if not ok and not window._renderFailed then
                window._renderFailed = true
                warn("[UILib Suprema render] " .. tostring(message))
            end
        end
    end
end

function Library:_ensureRuntime()
    if self._started then
        return
    end
    self._started = true
    self._destroyed = false
    table.insert(self._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        self:_inputBegan(input, gameProcessed)
    end))
    table.insert(self._connections, UserInputService.InputChanged:Connect(function(input)
        self:_inputChanged(input)
    end))
    table.insert(self._connections, UserInputService.InputEnded:Connect(function(input)
        self:_inputEnded(input)
    end))
    table.insert(self._connections, RunService.RenderStepped:Connect(function(deltaTime)
        self:_render(deltaTime)
    end))
    if UserInputService.WindowFocusReleased then
        table.insert(self._connections, UserInputService.WindowFocusReleased:Connect(function()
            self._pointerCapture = nil
            for _, window in ipairs(self.Windows) do
                window:_releaseHeldKeybinds()
            end
        end))
    end
end

local function optionVector(value, fallback)
    if typeof(value) == "Vector2" then
        return value
    elseif type(value) == "table" then
        return vector(value.X or value[1] or fallback.X, value.Y or value[2] or fallback.Y)
    end
    return fallback
end

function Library:CreateWindow(options)
    options = options or {}
    local capabilities = self:GetCapabilities()
    assert(capabilities.Drawing, "UILib Suprema cannot create a window: Drawing API is unavailable")
    self:_ensureRuntime()
    self._windowSerial = self._windowSerial + 1
    self._displaySerial = self._displaySerial + 1

    local size = optionVector(options.Size, vector(900, 640))
    local viewport = viewportSize()
    size = vector(clamp(size.X, 580, max(580, viewport.X - 24)), clamp(size.Y, 420, max(420, viewport.Y - 24)))
    local defaultPosition = vector(floor((viewport.X - size.X) / 2), floor((viewport.Y - size.Y) / 2))
    local position = optionVector(options.Position, defaultPosition)
    local windowId = tostring(options.Id or options.ID or ("window_" .. Library._windowSerial))
    if self.Flags[windowId] ~= nil then windowId = windowId .. "_" .. tostring(Library._windowSerial) end

    local self = setmetatable({
        Id = windowId,
        Title = tostring(options.Title or options.Name or "UILib Suprema"),
        Subtitle = tostring(options.Subtitle or options.Description or "Drawing interface"),
        Icon = options.Icon,
        Logo = options.Logo or options.LogoData,
        DisplayOrder = Library._displaySerial,
        Visible = options.Visible ~= false,
        Flags = {},
        Tabs = {},
        ActiveTab = nil,
        SearchText = "",
        Theme = merge(copy(Library.Theme), validatedThemePatch(options.Theme or {}, Library.Theme)),
        Settings = merge(copy(Library.Settings), validatedSettingsPatch(options.Settings or {})),
        _themePatch = copy(validatedThemePatch(options.Theme or {}, Library.Theme)),
        _drawings = {},
        _namedDrawings = {},
        _regions = {},
        _elements = {},
        _elementByFlag = {},
        _hotkeys = {},
        _notifications = {},
        _modal = nil,
        _overlay = nil,
        _focus = nil,
        _capturingKey = nil,
        _position = position,
        _targetPosition = position,
        _size = size,
        _targetSize = size,
        _alpha = options.Visible == false and 0 or 1,
        _destroyed = false,
        _pendingConfigValues = {},
        _tooltipOwner = nil,
        _tooltipSince = 0,
        _watermark = nil,
        _themeEditor = nil,
        ThemeTransparency = {},
        _window = nil,
    }, Window)
    self._window = self
    self._shellShadow = RoundRect.new(self, "shellShadow")
    self._shellBorder = RoundRect.new(self, "shellBorder")
    self._shell = RoundRect.new(self, "shell")
    self._searchBox = RoundRect.new(self, "searchBox")
    self._dragRegion = {
        Z = 45,
        OnBegan = function(input, positionAtStart)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            self:_clearFocus(true)
            local origin = self._targetPosition
            local pointerOrigin = positionAtStart
            Library:_capturePointer(self, function(current)
                local viewportNow = viewportSize()
                local candidate = origin + (current - pointerOrigin)
                self._targetPosition = vector(
                    clamp(candidate.X, -self._targetSize.X + 80, viewportNow.X - 80),
                    clamp(candidate.Y, 0, viewportNow.Y - 42)
                )
            end)
        end,
    }
    self._resizeRegion = {
        Z = 55,
        OnBegan = function(input, positionAtStart)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local originalSize = self._targetSize
            local pointerOrigin = positionAtStart
            Library:_capturePointer(self, function(current)
                local viewportNow = viewportSize()
                local candidate = originalSize + (current - pointerOrigin)
                self._targetSize = vector(
                    clamp(candidate.X, 580, max(580, viewportNow.X - self._targetPosition.X)),
                    clamp(candidate.Y, 420, max(420, viewportNow.Y - self._targetPosition.Y))
                )
            end)
        end,
    }
    self._searchRegion = {
        Z = 55,
        OnBegan = function(input)
            if isPrimaryPointer(input) then
                self:_focusText({
                    Kind = "Search",
                    Buffer = self.SearchText,
                    Commit = function(buffer)
                        self.SearchText = buffer
                    end,
                    Change = function(buffer)
                        self.SearchText = buffer
                    end,
                })
            end
        end,
    }
    self.Config = setmetatable({
        Window = self,
        Folder = tostring(options.ConfigFolder or self.Settings.ConfigFolder),
        AutoLoadFile = tostring(options.AutoLoadFile or self.Settings.AutoLoadFile),
        Available = {},
        Selected = nil,
        LastError = nil,
    }, ConfigManager)

    Library.Flags[self.Id] = self.Flags
    table.insert(Library.Windows, self)
    if options.ConfigManager ~= false and options.ConfigTab ~= false then
        self:_buildConfigTab()
    end
    task.defer(function()
        if not self._destroyed and options.AutoLoad ~= false then
            self.Config:LoadAuto()
        end
    end)
    return self
end

Library.Window = Library.CreateWindow
Library.NewWindow = Library.CreateWindow

function Window:BringToFront()
    Library._displaySerial = Library._displaySerial + 1
    self.DisplayOrder = Library._displaySerial
    return self
end

function Window:SetVisible(visible)
    self.Visible = visible == true
    if not self.Visible then
        self:_releaseHeldKeybinds()
        if Library._pointerCapture and Library._pointerCapture.Window == self then Library._pointerCapture = nil end
        self:_clearFocus(true)
        self._capturingKey = nil
        self._overlay = nil
        self._modal = nil
    end
    return self
end

function Window:Toggle()
    return self:SetVisible(not self.Visible)
end

function Window:SetTheme(themePatch, replace)
    themePatch = validatedThemePatch(themePatch or {}, self.Theme)
    if replace then
        self._themePatch = copy(themePatch)
    else
        self._themePatch = merge(self._themePatch, themePatch)
    end
    self.Theme = merge(copy(Library.Theme), self._themePatch)
    if self._syncConfigControls then self:_syncConfigControls() end
    return self
end

function Window:SetSettings(settingsPatch)
    merge(self.Settings, validatedSettingsPatch(settingsPatch or {}))
    if self._syncConfigControls then self:_syncConfigControls() end
    return self
end

function Window:SetFont(font, monoFont)
    self.Settings.Font = Library:ResolveFont(font)
    if monoFont ~= nil then self.Settings.MonoFont = Library:ResolveFont(monoFont) end
    if self._syncConfigControls then self:_syncConfigControls() end
    return self
end

function Window:GetFlag(flag)
    return self.Flags[flag]
end

function Window:SetFlag(flag, value, silent)
    local element = self._elementByFlag[flag]
    if element then
        element:Set(value, silent)
    else
        self._pendingConfigValues[flag] = value
        self.Flags[flag] = value
    end
    return self
end

function Window:_beginFrame()
    for _, drawing in ipairs(self._drawings) do
        drawing.Visible = false
    end
    table.clear(self._regions)
    self._tooltipCandidate = nil
end

function Window:_registerElement(element)
    table.insert(self._elements, element)
    if element.Flag and not element.IgnoreConfig then
        if self._elementByFlag[element.Flag] then
            warn(string.format("[UILib Suprema] duplicate flag '%s' inside window '%s'", element.Flag, self.Id))
        end
        self._elementByFlag[element.Flag] = element
        self.Flags[element.Flag] = element:Get()
        local pending = self._pendingConfigValues[element.Flag]
        if pending ~= nil then
            element._pendingConfigValue = pending
            self._pendingConfigValues[element.Flag] = nil
        end
    end
    if element._usesHotkey then
        table.insert(self._hotkeys, element)
    end
end

function Window:_clearFocus(commit)
    local focus = self._focus
    if focus then
        if commit and focus.Commit then
            safeCall(focus.Commit, focus.Buffer)
        elseif not commit and focus.Cancel then
            safeCall(focus.Cancel)
        end
    end
    self._focus = nil
end

function Window:_focusText(focus)
    self:_clearFocus(true)
    focus.Buffer = tostring(focus.Buffer or "")
    focus.Original = focus.Buffer
    self._focus = focus
end

function Window:_handleFocusedInput(input)
    if self._capturingKey then
        local capture = self._capturingKey
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then
            self._capturingKey = nil
            return true
        elseif input.UserInputType == Enum.UserInputType.Keyboard
            and (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete) then
            if capture.Type == "Keybind" then capture:SetKey(nil) else capture:SetKey(nil) end
            self._capturingKey = nil
            return true
        end
        local name = inputName(input)
        if name ~= "MouseMovement" and name ~= "Touch" then
            capture:SetKey(keyFromName(name))
            self._capturingKey = nil
            return true
        end
    end
    local focus = self._focus
    if not focus or input.UserInputType ~= Enum.UserInputType.Keyboard then
        return false
    end
    local keyCode = input.KeyCode
    if keyCode == Enum.KeyCode.Escape then
        self:_clearFocus(false)
    elseif keyCode == Enum.KeyCode.Return or keyCode == Enum.KeyCode.KeypadEnter then
        self:_clearFocus(true)
    elseif keyCode == Enum.KeyCode.Backspace then
        focus.Buffer = focus.Buffer:sub(1, max(0, #focus.Buffer - 1))
        if focus.Change then
            safeCall(focus.Change, focus.Buffer)
        end
    else
        local character = inputCharacter(input)
        if character and (not focus.MaxLength or #focus.Buffer < focus.MaxLength) then
            focus.Buffer = focus.Buffer .. character
            if focus.Change then
                safeCall(focus.Change, focus.Buffer)
            end
        end
    end
    return true
end

function Window:_handleGlobalInputBegan(input, gameProcessed)
    if self._destroyed then
        return false
    end
    if self.Visible and self._modal and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.Escape then
            self._modal.Close(false)
            return true
        elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
            self._modal.Close(true)
            return true
        end
    end
    if self._overlay and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then
        self._overlay = nil
        self:_clearFocus(false)
        return true
    end
    if inputMatchesKey(input, self.Settings.ToggleKey) then
        self:Toggle()
        return true
    end
    local handled = false
    local hotkeys = shallowArrayCopy(self._hotkeys)
    for _, element in ipairs(hotkeys) do
        if not element._destroyed and element:_hotkeyBegan(input, gameProcessed) then
            handled = true
        end
    end
    return handled
end

function Window:_handleGlobalInputEnded(input)
    for _, element in ipairs(shallowArrayCopy(self._hotkeys)) do
        if not element._destroyed then
            element:_hotkeyEnded(input)
        end
    end
end

function Window:_releaseHeldKeybinds()
    for _, element in ipairs(shallowArrayCopy(self._hotkeys)) do
        if not element._destroyed and element._holding then
            element._holding = false
            if element.Type == "Toggle" then
                element:Set(false)
            elseif element.Type == "Keybind" then
                element.Active = false
                safeCall(element.Callback, false, element.Value, element)
            end
        end
    end
end

function Window:_scrollActiveTab(direction)
    local tab = self.ActiveTab
    if not tab then
        return
    end
    tab.ScrollTarget = clamp(tab.ScrollTarget - direction * 46, 0, max(0, tab.ContentHeight - (self._contentClip and self._contentClip.H or 0)))
end

function Window:_render(deltaTime)
    for _, element in ipairs(self._elements) do
        if not element._destroyed then element:_applyPendingConfig() end
    end
    self:_beginFrame()
    local instantaneousFps = deltaTime > 0 and (1 / deltaTime) or 0
    self._fps = self._fps and (self._fps * 0.9 + instantaneousFps * 0.1) or instantaneousFps
    self._frameTime = deltaTime * 1000
    local factor = animationFactor(self.Settings, deltaTime)
    local targetAlpha = self.Visible and 1 or 0
    self._alpha = animateNumber(self._alpha, targetAlpha, factor)
    self._position = animateVector(self._position, self._targetPosition, factor)
    self._size = animateVector(self._size, self._targetSize, factor)
    if self._alpha <= 0.005 then
        local independentAlpha = self.Settings.Opacity
        local baseZ = self.DisplayOrder * 1000
        if self._watermark and self._watermark.Visible and not self._watermark.FollowWindowVisibility then
            self:_renderWatermark(baseZ + 950, independentAlpha)
        end
        if self._keybindList and self._keybindList.Visible and not self._keybindList.FollowWindowVisibility then
            self:_renderKeybindList(baseZ + 960, independentAlpha)
        end
        if self._statsOverlay and self._statsOverlay.Visible and not self._statsOverlay.FollowWindowVisibility then
            self:_renderStatsOverlay(baseZ + 970, independentAlpha)
        end
        return
    end

    local theme = self.Theme
    local settings = self.Settings
    local alpha = self._alpha * settings.Opacity
    local baseZ = self.DisplayOrder * 1000
    local position = self._position
    local size = self._size
    local radius = settings.Radius
    local sidebarWidth = size.X < 720 and 58 or clamp(settings.SidebarWidth, 150, size.X * 0.34)
    self._compactSidebar = size.X < 720
    local ta = self.ThemeTransparency or {}
    local bgAlpha = alpha * (ta.Background or 1)
    local sidebarAlpha = alpha * (ta.Sidebar or 1)
    local headerAlpha = alpha * (ta.Header or 1)
    local shadowAlpha = alpha * (ta.Shadow or 1) * 0.42

    self._shellShadow:Set(position + vector(0, 8), size, radius + 2, theme.Shadow, shadowAlpha, baseZ + 1, true)
    self._shellBorder:Set(position - vector(1, 1), size + vector(2, 2), radius + 1, theme.Border, alpha, baseZ + 2, true)
    self._shell:Set(position, size, radius, theme.Background, bgAlpha, baseZ + 3, true)

    local sidebar = namedDrawing(self, "window:sidebar", "Square", { Filled = true })
    showSquare(sidebar, rect(position.X, position.Y, sidebarWidth, size.Y), theme.Sidebar, sidebarAlpha, baseZ + 4)
    local header = namedDrawing(self, "window:header", "Square", { Filled = true })
    showSquare(header, rect(position.X + sidebarWidth, position.Y, size.X - sidebarWidth, settings.HeaderHeight), theme.Header, headerAlpha, baseZ + 4)
    local sidebarDivider = namedDrawing(self, "window:sidebarDivider", "Line")
    showLine(sidebarDivider, position + vector(sidebarWidth, 0), position + vector(sidebarWidth, size.Y), theme.BorderSoft, alpha, 1, baseZ + 7)
    local headerDivider = namedDrawing(self, "window:headerDivider", "Line")
    showLine(headerDivider, position + vector(sidebarWidth, settings.HeaderHeight), position + vector(size.X, settings.HeaderHeight), theme.BorderSoft, alpha, 1, baseZ + 7)

    local brandX = position.X + 16
    local brandWidth = sidebarWidth - 32
    if self.Logo then
        renderIcon(self, "window:logo", type(self.Logo) == "table" and self.Logo or { Data = self.Logo }, vector(brandX, position.Y + 15), 28, theme.Accent, alpha, baseZ + 12)
        brandX = brandX + 38
        brandWidth = brandWidth - 38
    elseif self.Icon then
        renderIcon(self, "window:icon", self.Icon, vector(brandX, position.Y + 17), 22, theme.Accent, alpha, baseZ + 12)
        brandX = brandX + 32
        brandWidth = brandWidth - 32
    end
    if not self._compactSidebar then
        local brand = namedDrawing(self, "window:brand", "Text")
        showText(brand, trimText(self.Title, brandWidth, settings.TitleFontSize), vector(brandX, position.Y + 13), theme.Text, settings.TitleFontSize, settings.Font, alpha, baseZ + 12)
        local brandSub = namedDrawing(self, "window:brandSub", "Text")
        showText(brandSub, trimText(self.Subtitle, brandWidth, settings.SmallFontSize), vector(brandX, position.Y + 34), theme.TextSecondary, settings.SmallFontSize, settings.Font, alpha, baseZ + 12)
    end

    local activeName = self.ActiveTab and self.ActiveTab.Name or "Overview"
    local pageTitle = namedDrawing(self, "window:pageTitle", "Text")
    showText(pageTitle, activeName, position + vector(sidebarWidth + 18, 17), theme.Text, settings.TitleFontSize, settings.Font, alpha, baseZ + 12)

    local searchWidth = clamp((size.X - sidebarWidth) * 0.36, 130, 245)
    local searchPosition = position + vector(size.X - searchWidth - 16, 12)
    self._searchBox:Set(searchPosition, vector(searchWidth, 34), 5, theme.Input, alpha, baseZ + 9, true)
    local searchBorder = namedDrawing(self, "window:searchBorder", "Square", { Filled = false })
    showSquare(searchBorder, rect(searchPosition.X, searchPosition.Y, searchWidth, 34), self._focus and self._focus.Kind == "Search" and theme.Accent or theme.BorderSoft, alpha, baseZ + 10, false, 1)
    local searchText = namedDrawing(self, "window:searchText", "Text")
    local visibleSearch = self._focus and self._focus.Kind == "Search" and self._focus.Buffer or self.SearchText
    showText(searchText, visibleSearch ~= "" and trimText(visibleSearch, searchWidth - 38, settings.FontSize) or "Search elements...", searchPosition + vector(30, 9), visibleSearch ~= "" and theme.Text or theme.TextDisabled, settings.FontSize, settings.Font, alpha, baseZ + 12)
    local searchCircle = namedDrawing(self, "window:searchCircle", "Circle", { Filled = false, NumSides = 18 })
    setDrawing(searchCircle, {
        Position = searchPosition + vector(13, 15), Radius = 4.5, NumSides = 18,
        Thickness = 1.25, Filled = false, Color = theme.TextSecondary,
        Transparency = alpha, ZIndex = baseZ + 12, Visible = true,
    })
    local searchHandle = namedDrawing(self, "window:searchHandle", "Line")
    showLine(searchHandle, searchPosition + vector(16.5, 18.5), searchPosition + vector(20, 22), theme.TextSecondary, alpha, 1.25, baseZ + 12)
    self._searchRegion.Rect = rect(searchPosition.X, searchPosition.Y, searchWidth, 34)
    registerRegion(self, self._searchRegion)

    self._dragRegion.Rect = rect(position.X, position.Y, max(0, size.X - searchWidth - 26), settings.HeaderHeight)
    registerRegion(self, self._dragRegion)
    self._resizeRegion.Rect = rect(position.X + size.X - 16, position.Y + size.Y - 16, 16, 16)
    registerRegion(self, self._resizeRegion)
    local resizeA = namedDrawing(self, "window:resizeA", "Line")
    local resizeB = namedDrawing(self, "window:resizeB", "Line")
    showLine(resizeA, position + size - vector(12, 4), position + size - vector(4, 12), theme.Border, alpha, 1, baseZ + 20)
    showLine(resizeB, position + size - vector(8, 4), position + size - vector(4, 8), theme.Border, alpha, 1, baseZ + 20)

    local tabY = position.Y + 76
    local tabHeight = 38
    local tabGap = 6
    for index, tab in ipairs(self.Tabs) do
        if tab.Visible then
            local tabRect = rect(position.X + (self._compactSidebar and 9 or 12), tabY, sidebarWidth - (self._compactSidebar and 18 or 24), tabHeight)
            tab._lastRect = tabRect
            local hovered = pointIn(Library._mouse, tabRect)
            local target = self.ActiveTab == tab and 1 or (hovered and 0.55 or 0)
            tab._hover = animateNumber(tab._hover or 0, target, factor)
            local tabBackground = namedDrawing(tab, "tab:background", "Square", { Filled = true })
            showSquare(tabBackground, tabRect, colorLerp(theme.Sidebar, theme.AccentMuted, tab._hover), alpha, baseZ + 9)
            if self.ActiveTab == tab then
                local indicator = namedDrawing(tab, "tab:indicator", "Square", { Filled = true })
                showSquare(indicator, rect(tabRect.X, tabRect.Y + 8, 3, tabRect.H - 16), theme.Accent, alpha, baseZ + 13)
            end
