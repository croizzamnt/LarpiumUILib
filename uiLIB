local unpack = table.unpack or unpack
local floor = math.floor
local min = math.min
local max = math.max
local abs = math.abs

local function clamp(value, low, high)
    return max(low, min(high, value))
end

local function roundTo(value, step)
    if not step or step <= 0 then
        return value
    end
    return floor((value / step) + 0.5) * step
end

local function copy(value, seen)
    if type(value) ~= "table" then
        return value
    end
    seen = seen or {}
    if seen[value] then
        return seen[value]
    end
    local result = {}
    seen[value] = result
    for key, item in pairs(value) do
        result[copy(key, seen)] = copy(item, seen)
    end
    return result
end

local function merge(target, patch)
    for key, value in pairs(patch or {}) do
        if type(value) == "table" and type(target[key]) == "table" then
            merge(target[key], value)
        else
            target[key] = value
        end
    end
    return target
end

local function shallowArrayCopy(source)
    local result = {}
    for index, value in ipairs(source or {}) do
        result[index] = value
    end
    return result
end

local function containsInsensitive(haystack, needle)
    if needle == "" then
        return true
    end
    return string.find(string.lower(tostring(haystack or "")), string.lower(needle), 1, true) ~= nil
end

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return true
    end
    local arguments = { ... }
    local ok, result = xpcall(function()
        return callback(unpack(arguments))
    end, function(message)
        return debug.traceback(tostring(message), 2)
    end)
    if not ok then
        warn("[UILib Suprema callback] " .. tostring(result))
    end
    return ok, result
end

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function colorFromHex(value)
    local cleaned = tostring(value or ""):gsub("#", ""):gsub("0x", "")
    if #cleaned == 3 then
        cleaned = cleaned:sub(1, 1):rep(2) .. cleaned:sub(2, 2):rep(2) .. cleaned:sub(3, 3):rep(2)
    end
    if #cleaned ~= 6 or not cleaned:match("^[%da-fA-F]+$") then
        return nil
    end
    return Color3.fromRGB(
        tonumber(cleaned:sub(1, 2), 16),
        tonumber(cleaned:sub(3, 4), 16),
        tonumber(cleaned:sub(5, 6), 16)
    )
end

local function colorToHex(color)
    return string.format(
        "#%02X%02X%02X",
        floor(clamp(color.R, 0, 1) * 255 + 0.5),
        floor(clamp(color.G, 0, 1) * 255 + 0.5),
        floor(clamp(color.B, 0, 1) * 255 + 0.5)
    )
end

local function colorLerp(a, b, alpha)
    return Color3.new(
        a.R + (b.R - a.R) * alpha,
        a.G + (b.G - a.G) * alpha,
        a.B + (b.B - a.B) * alpha
    )
end

local function pointIn(position, rect)
    return position.X >= rect.X and position.Y >= rect.Y
        and position.X <= rect.X + rect.W and position.Y <= rect.Y + rect.H
end

local function intersects(rect, clip)
    return rect.X + rect.W >= clip.X and rect.X <= clip.X + clip.W
        and rect.Y + rect.H >= clip.Y and rect.Y <= clip.Y + clip.H
end

local function fullyInsideVertical(rect, clip)
    return rect.Y >= clip.Y and rect.Y + rect.H <= clip.Y + clip.H
end

local function rect(x, y, width, height)
    return { X = x, Y = y, W = width, H = height }
end

local function vector(x, y)
    return Vector2.new(x, y)
end

local function viewportSize()
    local camera = Workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

local function animationFactor(settings, deltaTime)
    if not settings.Animations then
        return 1
    end
    local speed = max(0.01, tonumber(settings.AnimationSpeed) or 14)
    local mode = string.lower(tostring(settings.Easing or "exponential"))
    if mode == "linear" then
        return clamp(deltaTime * speed, 0, 1)
    elseif mode == "smooth" or mode == "smoothstep" then
        local t = clamp(deltaTime * speed, 0, 1)
        return t * t * (3 - 2 * t)
    end
    return 1 - math.exp(-speed * deltaTime)
end

local function animateNumber(current, target, factor)
    if abs(target - current) < 0.001 then
        return target
    end
    return current + (target - current) * factor
end

local function animateVector(current, target, factor)
    if (target - current).Magnitude < 0.05 then
        return target
    end
    return current:Lerp(target, factor)
end

local function normalizeOptions(options)
    local result = {}
    for _, option in ipairs(options or {}) do
        if type(option) == "table" then
            local optionValue
            local labelValue
            if option.Value ~= nil then
                optionValue = option.Value
            elseif option.Name ~= nil then
                optionValue = option.Name
            else
                optionValue = option.Label
            end
            if option.Label ~= nil then
                labelValue = option.Label
            elseif option.Name ~= nil then
                labelValue = option.Name
            elseif option.Value ~= nil then
                labelValue = option.Value
            else
                labelValue = "Option"
            end
            table.insert(result, {
                Label = tostring(labelValue),
                Value = optionValue,
                Disabled = option.Disabled == true,
            })
        else
            table.insert(result, { Label = tostring(option), Value = option, Disabled = false })
        end
    end
    return result
end

local function optionLabel(options, value)
    for _, option in ipairs(options or {}) do
        if option.Value == value then
            return option.Label
        end
    end
    return tostring(value == nil and "" or value)
end


local function firstEnabledValue(options)
    for _, option in ipairs(options or {}) do
        if not option.Disabled then return option.Value end
    end
    return nil
end

local function removeValue(array, value)
    for index = #array, 1, -1 do
        if array[index] == value then
            table.remove(array, index)
        end
    end
end

local function hasValue(array, value)
    for _, candidate in ipairs(array or {}) do
        if candidate == value then
            return true
        end
    end
    return false
end

local function enumName(value)
    if typeof(value) == "EnumItem" then
        return value.Name
    end
    local text = tostring(value or "None")
    return text:match("%.([^%.]+)$") or text
end

local function keyFromName(name)
    if not name or name == "None" then
        return nil
    end
    return Enum.KeyCode[name] or Enum.UserInputType[name]
end

local function inputName(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name
    end
    return input.UserInputType.Name
end

local function isPrimaryPointer(input)
    local inputType = input.UserInputType
    return inputType == Enum.UserInputType.MouseButton1
        or inputType == Enum.UserInputType.Touch
end

local function inputMatchesKey(input, key)
    if not key then
        return false
    end
    local name = enumName(key)
    if name == "Unknown" or name == "None" then
        return false
    end
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.KeyCode then
            return input.KeyCode == key
        end
        return input.UserInputType == key
    end
    return inputName(input) == tostring(key)
end

local function pointerPosition(input)
    if input and input.UserInputType == Enum.UserInputType.Touch then
        return vector(input.Position.X, input.Position.Y)
    end
    return UserInputService:GetMouseLocation()
end

local shiftCharacters = {
    One = "!", Two = "@", Three = "#", Four = "$", Five = "%",
    Six = "^", Seven = "&", Eight = "*", Nine = "(", Zero = ")",
    Minus = "_", Equals = "+", LeftBracket = "{", RightBracket = "}",
    BackSlash = "|", Semicolon = ":", Quote = "\"", Comma = "<",
    Period = ">", Slash = "?", Backquote = "~",
}

local normalCharacters = {
    Space = " ", One = "1", Two = "2", Three = "3", Four = "4", Five = "5",
    Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0",
    Minus = "-", Equals = "=", LeftBracket = "[", RightBracket = "]",
    BackSlash = "\\", Semicolon = ";", Quote = "'", Comma = ",",
    Period = ".", Slash = "/", Backquote = "`",
}

local function inputCharacter(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return nil
    end
    local name = input.KeyCode.Name
    if #name == 1 and name:match("%a") then
        local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        return shift and string.upper(name) or string.lower(name)
    end
    local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
    return (shift and shiftCharacters[name]) or normalCharacters[name]
end

