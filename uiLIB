            self:SetMode(value.Mode or self.KeyMode, silent)
            self.Color = value.Color or self.Color
            self.ColorAlpha = value.Alpha or self.ColorAlpha
            if value.ShowInList ~= nil then self.ShowInList = value.ShowInList == true end
