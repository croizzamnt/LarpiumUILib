function Section:AddColorPicker(options)
    options = options or {}
    local defaultColor = options.Default or options.Color or self._window.Theme.Accent
    if type(defaultColor) == "string" then defaultColor = colorFromHex(defaultColor) or self._window.Theme.Accent end
    local element = makeElement(self, "ColorPicker", options, defaultColor, 46)
    element.Value = typeof(element.Value) == "Color3" and element.Value or self._window.Theme.Accent
    element.Alpha = clamp(tonumber(options.Alpha) or 1, 0, 1)
    element.AllowAlpha = options.AllowAlpha ~= false
    function element:Set(color, alphaOrSilent, silent)
        local alpha = nil
        if type(color) == "table" and typeof(color) ~= "Color3" then
            alpha = color.Alpha
            color = color.Color or color.Value
        elseif type(alphaOrSilent) == "number" then
            alpha = alphaOrSilent
        else
            silent = alphaOrSilent
        end
        if type(color) == "string" then color = colorFromHex(color) end
        if typeof(color) == "Color3" then self.Value = color end
        if alpha ~= nil then self.Alpha = clamp(tonumber(alpha) or self.Alpha, 0, 1) end
        if self.Flag then self._window.Flags[self.Flag] = { Color = self.Value, Alpha = self.Alpha } end
        if not silent then safeCall(self.Callback, self.Value, self.Alpha, self) end
        return self
    end
    element.SetValue = element.Set
    function element:Serialize()
        return serializedValue({ Color = self.Value, Alpha = self.Alpha })
    end
    function element:Deserialize(value, silent)
        value = deserializedValue(value)
        if type(value) == "table" then return self:Set(value.Color, value.Alpha, silent) end
        return self:Set(value, silent)
    end
    function element:_onClick()
        if self._window._overlay and self._window._overlay.Kind == "Color" and self._window._overlay.Owner == self then
            self._window._overlay = nil
        else
            self._window:_openColor(self, self._swatchRect or self._lastRect)
        end
    end
    function element:_render(context, targetRect)
        if not fullyInsideVertical(targetRect, context.Clip) then return end
        local open = self._window._overlay and self._window._overlay.Kind == "Color" and self._window._overlay.Owner == self
        self:_card(context, targetRect, open)
        self:_label(context, targetRect, 135)
        local hex = colorToHex(self.Value)
        local hexText = self:_drawing("color:hex", "Text")
        showText(hexText, hex, vector(targetRect.X + targetRect.W - 105, targetRect.Y + floor((targetRect.H - context.Settings.SmallFontSize) / 2) - 1), context.Theme.TextSecondary, context.Settings.SmallFontSize, context.Settings.MonoFont, context.Alpha, context.Z + 15)
        self._swatchRect = rect(targetRect.X + targetRect.W - 40, targetRect.Y + floor((targetRect.H - 24) / 2), 28, 24)
        local swatch = self:_drawing("color:swatch", "Square", { Filled = true })
        local swatchBorder = self:_drawing("color:border", "Square", { Filled = false })
        showSquare(swatch, self._swatchRect, self.Value, context.Alpha * self.Alpha, context.Z + 15)
        showSquare(swatchBorder, self._swatchRect, context.Theme.Border, context.Alpha, context.Z + 16, false, 1)
        self:_registerMain(context, targetRect)
    end
    if element.Flag then self._window.Flags[element.Flag] = { Color = element.Value, Alpha = element.Alpha } end
    return element
end

