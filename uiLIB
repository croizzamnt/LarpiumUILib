local function splitLines(value)
    local lines = {}
    value = tostring(value or "")
    if value == "" then return lines end
    value = value:gsub("\r\n", "\n"):gsub("\r", "\n")
    for line in (value .. "\n"):gmatch("(.-)\n") do
        table.insert(lines, line)
    end
    return lines
end

function Section:AddLogViewer(options)
    options = options or {}
    options.IgnoreConfig = true
    local initial = options.Lines or options.Text or options.Code or {}
    local element = makeElement(self, options.Code and "CodeViewer" or "LogViewer", options, nil, tonumber(options.Height) or 184)
    element.Lines = type(initial) == "table" and shallowArrayCopy(initial) or splitLines(initial)
    element.MaxLines = max(1, floor(tonumber(options.MaxLines) or 500))
    element.Scroll = 0
    element.AutoScroll = options.AutoScroll ~= false
    element.ShowLineNumbers = options.LineNumbers ~= false
    element.Copyable = options.Copyable ~= false
    element.Mode = options.Language or (options.Code and "lua" or "log")
    function element:Append(line)
        local incoming = splitLines(line)
        if #incoming == 0 then incoming = { tostring(line or "") } end
        for _, value in ipairs(incoming) do table.insert(self.Lines, tostring(value)) end
        while #self.Lines > self.MaxLines do table.remove(self.Lines, 1) end
        if self.AutoScroll then self.Scroll = math.huge end
        return self
    end
    element.Add = element.Append
    function element:Clear()
        table.clear(self.Lines)
        self.Scroll = 0
        return self
    end
    function element:SetText(text)
        self.Lines = splitLines(text)
        self.Scroll = 0
        return self
    end
    function element:GetText()
        return table.concat(self.Lines, "\n")
    end
    element._wheelRegion = {
        Z = 0,
        OnWheel = function(direction)
            element.AutoScroll = false
            element.Scroll = element.Scroll - direction * 2
        end,
        OnBegan = function() end,
    }
    function element:_onClick(position)
        if self.Copyable and self._copyRect and pointIn(position, self._copyRect) then
            if type(setclipboard) == "function" then
                local ok = pcall(setclipboard, self:GetText())
                self._copyFeedback = ok and (os.clock() + 1) or nil
            else
                self._window:Notify({ Type = "Warning", Title = "Clipboard unavailable", Description = "This executor does not expose setclipboard." })
            end
        end
    end
    function element:_render(context, targetRect)
        if not fullyInsideVertical(targetRect, context.Clip) then return end
        self:_card(context, targetRect, false)
        local headerHeight = 34
        local title = self:_drawing("log:title", "Text")
        showText(title, self.Name, vector(targetRect.X + 11, targetRect.Y + 10), context.Theme.Text, context.Settings.FontSize, context.Settings.Font, context.Alpha, context.Z + 13)
        if self.Copyable then
            self._copyRect = rect(targetRect.X + targetRect.W - 58, targetRect.Y + 6, 48, 22)
            local copyBackground = self:_drawing("log:copyBg", "Square", { Filled = true })
            showSquare(copyBackground, self._copyRect, context.Theme.Input, context.Alpha, context.Z + 14)
            local copyText = self:_drawing("log:copyText", "Text")
            showText(copyText, self._copyFeedback and self._copyFeedback > os.clock() and "Copied" or "Copy", vector(self._copyRect.X + self._copyRect.W / 2, self._copyRect.Y + 5), context.Theme.TextSecondary, context.Settings.SmallFontSize, context.Settings.Font, context.Alpha, context.Z + 16, true)
        end
        local viewerRect = rect(targetRect.X + 8, targetRect.Y + headerHeight, targetRect.W - 16, targetRect.H - headerHeight - 8)
        local viewer = self:_drawing("log:viewer", "Square", { Filled = true })
        showSquare(viewer, viewerRect, context.Theme.Input, context.Alpha, context.Z + 11)
        local lineHeight = context.Settings.SmallFontSize + 5
        local visibleLines = max(1, floor((viewerRect.H - 8) / lineHeight))
        local maxScroll = max(0, #self.Lines - visibleLines)
        if self.Scroll == math.huge then self.Scroll = maxScroll end
        self.Scroll = clamp(floor(self.Scroll), 0, maxScroll)
        for visualIndex = 1, visibleLines do
            local lineIndex = self.Scroll + visualIndex
            local line = self.Lines[lineIndex]
            if not line then break end
            local y = viewerRect.Y + 5 + (visualIndex - 1) * lineHeight
            local x = viewerRect.X + 7
            if self.ShowLineNumbers then
                local number = self:_drawing("log:number:" .. visualIndex, "Text")
                showText(number, tostring(lineIndex), vector(x, y), context.Theme.TextDisabled, context.Settings.SmallFontSize, context.Settings.MonoFont, context.Alpha, context.Z + 15)
                x = x + max(26, estimateTextWidth(tostring(#self.Lines), context.Settings.SmallFontSize) + 10)
            end
            local lineDrawing = self:_drawing("log:line:" .. visualIndex, "Text")
            local lineColor = context.Theme.TextSecondary
            if line:match("^%s*%-%-") then lineColor = context.Theme.TextDisabled
            elseif line:match("error") or line:match("Error") then lineColor = context.Theme.Error
            elseif line:match("warn") or line:match("Warn") then lineColor = context.Theme.Warning
            elseif line:match("^%s*local[%s]") or line:match("^%s*function[%s]")
                or line:match("^%s*return[%s]") or line:match("^%s*if[%s]")
                or line:match("^%s*for[%s]") or line:match("^%s*while[%s]") then
                lineColor = context.Theme.Info
            end
            showText(lineDrawing, trimText(line, viewerRect.X + viewerRect.W - x - 8, context.Settings.SmallFontSize), vector(x, y), lineColor, context.Settings.SmallFontSize, context.Settings.MonoFont, context.Alpha, context.Z + 15)
        end
        self._wheelRegion.Rect = viewerRect
        self._wheelRegion.Z = context.Z + 32
        registerRegion(self._window, self._wheelRegion)
        self:_registerMain(context, targetRect)
    end
    return element
end

