Library.SavedThemes = {}

function Library:LoadSavedThemes()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    local path = self.DefaultSettings.ConfigFolder .. "/saved_themes.json"
    if not isfile(path) then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and type(data) == "table" then
        for name, themeData in pairs(data) do
            if type(themeData) == "table" then
                local resolved = {}
                for key, val in pairs(themeData) do
                    if type(val) == "table" and val.R and val.G and val.B then
                        resolved[key] = Color3.new(val.R, val.G, val.B)
                    elseif type(val) == "number" then
                        resolved["__transparency_" .. key] = val
                    end
                end
                self.SavedThemes[name] = resolved
            end
        end
    end
end

function Library:SaveThemeToFile(name, themeData)
    if type(writefile) ~= "function" then return false end
    local folder = self.DefaultSettings.ConfigFolder
    if type(isfolder) ~= "function" then return false end
    if not isfolder(folder) then pcall(makefolder, folder) end
    local path = folder .. "/saved_themes.json"
    local existing = {}
    if type(isfile) == "function" and isfile(path) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if ok and type(data) == "table" then existing = data end
    end
    local encoded = {}
    for key, val in pairs(themeData) do
        if typeof(val) == "Color3" then
            encoded[key] = { R = val.R, G = val.G, B = val.B }
        elseif type(val) == "number" then
            encoded[key] = val
        end
    end
    existing[name] = encoded
    local ok, json = pcall(function() return HttpService:JSONEncode(existing) end)
    if not ok then return false end
    pcall(writefile, path, json)
    return true
end

function Window:_themeAlpha(tokenKey, baseAlpha)
    if not self.ThemeTransparency then return baseAlpha end
    local t = self.ThemeTransparency[tokenKey]
    if t == nil then return baseAlpha end
    return baseAlpha * clamp(t, 0, 1)
end



function Window:OpenThemeEditor()
    if self._themeEditor and self._themeEditor.Open then
        return self
    end
    local vp = viewportSize()
    local panelWidth = min(780, vp.X - 48)
    local panelHeight = min(520, vp.Y - 48)
    self._themeEditor = {
        Open = true,
        Position = vector((vp.X - panelWidth) / 2, (vp.Y - panelHeight) / 2),
        PanelWidth = panelWidth,
        PanelHeight = panelHeight,
        TokenProxies = {},
        ActiveHexEdit = nil,
        SaveBuffer = "",
        Scroll = 0,
    }
    local editor = self._themeEditor
    for _, col in ipairs(ThemeEditorColumns) do
        for _, token in ipairs(col.Tokens) do
            local proxy = {
                Type = "ThemeProxy",
                Name = token.Label,
                Value = self.Theme[token.Key] or Color3.new(1, 1, 1),
                Alpha = 1,
                AllowAlpha = false,
                _window = self,
                _themeKey = token.Key,
                _namedDrawings = {},
                _destroyed = false,
            }
            function proxy:Set(color, alphaOrSilent, silent)
                if typeof(color) == "Color3" then
                    self.Value = color
                    self._window.Theme[self._themeKey] = color
                    self._window._themePatch[self._themeKey] = color
                end
                return self
            end
            proxy.SetValue = proxy.Set
            editor.TokenProxies[token.Key] = proxy
        end
    end
    editor.CloseRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then
                editor.Open = false
            end
        end,
    }
    editor.SaveRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then
                self:_focusText({
                    Kind = "ThemeSave",
                    Buffer = editor.SaveBuffer,
                    MaxLength = 32,
                    Commit = function(buffer)
                        if buffer and #buffer > 0 then
                            editor.SaveBuffer = buffer
                            local themeData = {}
                            for _, col in ipairs(ThemeEditorColumns) do
                                for _, token in ipairs(col.Tokens) do
                                    themeData[token.Key] = self.Theme[token.Key]
                                    if self.ThemeTransparency and self.ThemeTransparency[token.Key] then
                                        themeData["__transparency_" .. token.Key] = self.ThemeTransparency[token.Key]
                                    end
                                end
                            end
                            Library:SaveThemeToFile(buffer, themeData)
                            Library.SavedThemes[buffer] = themeData
                            self:Notify({ Type = "Success", Title = "Theme saved", Description = "'" .. buffer .. "' was saved successfully. Select it from the theme dropdown." })
                        end
                    end,
                })
            end
        end,
    }
    editor.ResetRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then
                self._themePatch = {}
                self.Theme = copy(Library.Theme)
                for _, col in ipairs(ThemeEditorColumns) do
                    for _, token in ipairs(col.Tokens) do
                        if editor.TokenProxies[token.Key] then
                            editor.TokenProxies[token.Key].Value = self.Theme[token.Key]
                        end
                    end
                end
                self.ThemeTransparency = {}
            end
        end,
    }
    editor.WheelRegion = {
        Z = 0,
        OnWheel = function(direction)
            editor.Scroll = max(0, editor.Scroll - direction * 30)
        end,
        OnBegan = function() end,
    }
    return self
end

Window.OpenThemeEditor = Window.OpenThemeEditor

function Window:_closeThemeEditor()
    if self._themeEditor then
        self._themeEditor.Open = false
        self._themeEditor = nil
    end
end

function Window:_renderThemeEditor(deltaTime, baseZ, alpha)
    local editor = self._themeEditor
    if not editor or not editor.Open then return end
    local factor = animationFactor(self.Settings, deltaTime)
    editor.Progress = animateNumber(editor.Progress or 0, 1, factor)
    local edAlpha = alpha * editor.Progress
    local vp = viewportSize()
    local panelWidth = editor.PanelWidth or 780
    local panelHeight = editor.PanelHeight or 520
    local x = editor.Position.X
    local y = editor.Position.Y
    local overlayBg = namedDrawing(self, "themeEditor:overlay", "Square", { Filled = true })
    showSquare(overlayBg, rect(0, 0, vp.X, vp.Y), Color3.new(0, 0, 0), edAlpha * 0.5, baseZ - 1)
    local panelRect = rect(x, y, panelWidth, panelHeight)
    editor.PanelRect = panelRect
    if not self._themeEditorRound then
        self._themeEditorRound = RoundRect.new(self, "themeEditor")
    end
    self._themeEditorRound:Set(
        vector(x, y), vector(panelWidth, panelHeight),
        self.Settings.Radius + 2, self.Theme.Popup, edAlpha, baseZ, true
    )
    local border = namedDrawing(self, "themeEditor:border", "Square", { Filled = false })
    showSquare(border, panelRect, self.Theme.Border, edAlpha, baseZ + 1, false, 1)
    local headerHeight = 50
    local headerRect = rect(x, y, panelWidth, headerHeight)
    local headerBg = namedDrawing(self, "themeEditor:header", "Square", { Filled = true })
    showSquare(headerBg, headerRect, self.Theme.Header, edAlpha, baseZ + 2)
    local title = namedDrawing(self, "themeEditor:title", "Text")
    renderIcon(self, "themeEditor:icon", "palette", vector(x + 14, y + 14), 20, self.Theme.Accent, edAlpha, baseZ + 5)
    showText(title, "Theme Editor", vector(x + 42, y + 14), self.Theme.Text, self.Settings.TitleFontSize, self.Settings.Font, edAlpha, baseZ + 5, false, true)
    local saveBg = namedDrawing(self, "themeEditor:saveBg", "Square", { Filled = true })
    local saveRect = rect(x + panelWidth - 175, y + 12, 70, 28)
    showSquare(saveBg, saveRect, self.Theme.Accent, edAlpha, baseZ + 3)
    local saveText = namedDrawing(self, "themeEditor:saveLabel", "Text")
    showText(saveText, "Save", vector(saveRect.X + saveRect.W / 2, saveRect.Y + 7), Color3.new(1, 1, 1), self.Settings.FontSize, self.Settings.Font, edAlpha, baseZ + 5, true, true)
    editor.SaveRegion.Rect = saveRect
    editor.SaveRegion.Z = baseZ + 20
    registerRegion(self, editor.SaveRegion)
    local resetBg = namedDrawing(self, "themeEditor:resetBg", "Square", { Filled = true })
    local resetRect = rect(x + panelWidth - 95, y + 12, 70, 28)
    showSquare(resetBg, resetRect, self.Theme.CardHover, edAlpha, baseZ + 3)
    local resetText = namedDrawing(self, "themeEditor:resetLabel", "Text")
    showText(resetText, "Reset", vector(resetRect.X + resetRect.W / 2, resetRect.Y + 7), self.Theme.Text, self.Settings.FontSize, self.Settings.Font, edAlpha, baseZ + 5, true, true)
    editor.ResetRegion.Rect = resetRect
    editor.ResetRegion.Z = baseZ + 20
    registerRegion(self, editor.ResetRegion)
    local closeText = namedDrawing(self, "themeEditor:close", "Text")
    showText(closeText, "x", vector(x + panelWidth - 22, y + 14), self.Theme.TextSecondary, self.Settings.FontSize + 2, self.Settings.Font, edAlpha, baseZ + 5, true, true)
    editor.CloseRegion.Rect = rect(x + panelWidth - 36, y + 6, 32, 32)
    editor.CloseRegion.Z = baseZ + 20
    registerRegion(self, editor.CloseRegion)
    editor.WheelRegion.Rect = panelRect
    editor.WheelRegion.Z = baseZ + 5
    registerRegion(self, editor.WheelRegion)
    local contentY = y + headerHeight + 12
    local colWidth = floor((panelWidth - 36) / #ThemeEditorColumns)
    local rowHeight = 32
    local sectionHeaderHeight = 26
    local maxScrollRows = floor((panelHeight - headerHeight - 60) / rowHeight)
    for colIdx, col in ipairs(ThemeEditorColumns) do
        local colX = x + 12 + (colIdx - 1) * (colWidth + 4)
        local sectionLabel = namedDrawing(self, "themeEditor:section:" .. colIdx, "Text")
        showText(sectionLabel, col.Title, vector(colX, contentY), self.Theme.Accent, self.Settings.SmallFontSize + 1, self.Settings.Font, edAlpha, baseZ + 4, false, true)
        for rowIdx, token in ipairs(col.Tokens) do
            local rowY = contentY + sectionHeaderHeight + (rowIdx - 1) * rowHeight
            if rowY + rowHeight > y + panelHeight - 12 then break end
            local proxy = editor.TokenProxies[token.Key]
            local label = namedDrawing(self, "themeEditor:label:" .. colIdx .. ":" .. rowIdx, "Text")
            showText(label, trimText(token.Label, 72, self.Settings.SmallFontSize), vector(colX, rowY + 8), self.Theme.Text, self.Settings.SmallFontSize, self.Settings.Font, edAlpha, baseZ + 4, false, true)
            local swatchRect = rect(colX + 76, rowY + 5, 20, 20)
            local swatch = namedDrawing(self, "themeEditor:swatch:" .. colIdx .. ":" .. rowIdx, "Square", { Filled = true })
            showSquare(swatch, swatchRect, proxy.Value, edAlpha, baseZ + 4)
            local swatchBorder = namedDrawing(self, "themeEditor:swatchBorder:" .. colIdx .. ":" .. rowIdx, "Square", { Filled = false })
            showSquare(swatchBorder, swatchRect, self.Theme.Border, edAlpha, baseZ + 5, false, 1)
            local swatchHovered = pointIn(Library._mouse, swatchRect)
            if swatchHovered then
                local swatchHover = namedDrawing(self, "themeEditor:swatchHover:" .. colIdx .. ":" .. rowIdx, "Square", { Filled = false })
                showSquare(swatchHover, swatchRect, self.Theme.Accent, edAlpha, baseZ + 6, false, 1.5)
            end
            local swatchRegion = {
                Z = baseZ + 12,
                OnBegan = function(input)
                    if isPrimaryPointer(input) then
                        self:_openColor(proxy, swatchRect)
                    end
                end,
            }
            swatchRegion.Rect = swatchRect
            registerRegion(self, swatchRegion)
            local hex = colorToHex(proxy.Value)
            local hexKey = colIdx .. ":" .. rowIdx
            local isEditing = editor.ActiveHexEdit == hexKey
            local hexRect = rect(colX + 100, rowY + 4, 48, 22)
            if isEditing then
                local focusBuf = self._focus and self._focus.Buffer or hex
                local hexBg = namedDrawing(self, "themeEditor:hexBg:" .. hexKey, "Square", { Filled = true })
                showSquare(hexBg, hexRect, self.Theme.Input, edAlpha, baseZ + 4)
                local hexInputBorder = namedDrawing(self, "themeEditor:hexBorder:" .. hexKey, "Square", { Filled = false })
                showSquare(hexInputBorder, hexRect, self.Theme.Accent, edAlpha, baseZ + 5, false, 1)
                local hexDrawing = namedDrawing(self, "themeEditor:hexText:" .. hexKey, "Text")
                showText(hexDrawing, focusBuf, vector(hexRect.X + 4, rowY + 7), self.Theme.Text, self.Settings.SmallFontSize, self.Settings.MonoFont, edAlpha, baseZ + 6, false)
            else
                local hexDrawing = namedDrawing(self, "themeEditor:hexText:" .. hexKey, "Text")
                showText(hexDrawing, hex, vector(hexRect.X + 4, rowY + 7), self.Theme.TextSecondary, self.Settings.SmallFontSize, self.Settings.MonoFont, edAlpha, baseZ + 4, false)
                local hexRegion = {
                    Z = baseZ + 12,
                    OnBegan = function(input)
                        if isPrimaryPointer(input) then
                            editor.ActiveHexEdit = hexKey
                            self:_focusText({
                                Kind = "ThemeHex",
                                ThemeToken = token.Key,
                                Proxy = proxy,
                                Buffer = colorToHex(proxy.Value),
                                MaxLength = 7,
                                Commit = function(buffer)
                                    local parsed = colorFromHex(buffer)
                                    if parsed then
                                        proxy:Set(parsed)
                                    end
                                    editor.ActiveHexEdit = nil
                                end,
                                Cancel = function()
                                    editor.ActiveHexEdit = nil
                                end,
                            })
                        end
                    end,
                }
                hexRegion.Rect = hexRect
                registerRegion(self, hexRegion)
            end
            local sliderLabel = namedDrawing(self, "themeEditor:opacityLabel:" .. colIdx .. ":" .. rowIdx, "Text")
            showText(sliderLabel, "A", vector(colX + 152, rowY + 8), self.Theme.TextDisabled, self.Settings.SmallFontSize, self.Settings.MonoFont, edAlpha, baseZ + 4, false)
            local sliderBgRect = rect(colX + 164, rowY + 12, colWidth - 180, 5)
            local sliderBg = namedDrawing(self, "themeEditor:sliderBg:" .. colIdx .. ":" .. rowIdx, "Square", { Filled = true })
            showSquare(sliderBg, sliderBgRect, self.Theme.SliderTrack, edAlpha, baseZ + 4)
            local currentTransparency = self.ThemeTransparency and self.ThemeTransparency[token.Key] or 1
            local sliderFillWidth = sliderBgRect.W * currentTransparency
            local sliderFill = namedDrawing(self, "themeEditor:sliderFill:" .. colIdx .. ":" .. rowIdx, "Square", { Filled = true })
            showSquare(sliderFill, rect(sliderBgRect.X, sliderBgRect.Y, sliderFillWidth, sliderBgRect.H), self.Theme.Accent, edAlpha, baseZ + 5)
            local thumbX = sliderBgRect.X + sliderFillWidth
            local thumb = namedDrawing(self, "themeEditor:thumb:" .. colIdx .. ":" .. rowIdx, "Circle", { Filled = true, NumSides = 16 })
            setDrawing(thumb, {
                Position = vector(thumbX, sliderBgRect.Y + sliderBgRect.H / 2),
                Radius = 5, NumSides = 16, Filled = true, Color = self.Theme.Text,
                Transparency = edAlpha, ZIndex = baseZ + 6, Visible = true,
            })
            local pctText = namedDrawing(self, "themeEditor:pct:" .. colIdx .. ":" .. rowIdx, "Text")
            showText(pctText, tostring(floor(currentTransparency * 100 + 0.5)) .. "%", vector(sliderBgRect.X + sliderBgRect.W + 4, rowY + 7), self.Theme.TextDisabled, self.Settings.SmallFontSize - 1, self.Settings.MonoFont, edAlpha, baseZ + 4, false)
            local sliderRegion = {
                Z = baseZ + 12,
                OnBegan = function(input, position)
                    if isPrimaryPointer(input) then
                        local function updateFromPosition(pos)
                            local ratio = clamp((pos.X - sliderBgRect.X) / sliderBgRect.W, 0, 1)
                            if not self.ThemeTransparency then self.ThemeTransparency = {} end
                            self.ThemeTransparency[token.Key] = ratio
                        end
                        updateFromPosition(position)
                        Library:_capturePointer(self, function(current)
                            updateFromPosition(current)
                        end)
                    end
                end,
            }
            sliderRegion.Rect = sliderBgRect
            registerRegion(self, sliderRegion)
        end
    end
end

