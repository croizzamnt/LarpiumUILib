    function element:_coerce(value)
        if self.Numeric then
            return tonumber(value) or tonumber(self.Value) or 0
        end
        value = tostring(value or "")
        return value:sub(1, self.MaxLength)
    end
    element.Value = element:_coerce(element.Value)
    function element:_validate(buffer)
        if buffer == "" and not self.AllowEmpty then return false end
        if self.Numeric and buffer ~= "" and tonumber(buffer) == nil then return false end
        if type(self.Validation) == "function" then
            local ok, accepted = safeCall(self.Validation, buffer, self)
            return ok and accepted ~= false
        elseif type(self.Validation) == "string" and buffer ~= "" then
            return buffer:match(self.Validation) ~= nil
        end
        return true
    end
    function element:_beginInput()
        self._window:_focusText({
            Kind = "TextBox", Owner = self, Buffer = tostring(self.Value), MaxLength = self.MaxLength,
            Change = function(buffer)
                safeCall(self.OnChanged, self.Numeric and tonumber(buffer) or buffer, self)
            end,
            Commit = function(buffer)
                if self:_validate(buffer) then
                    self._invalidUntil = nil
                    self:Set(buffer)
                    safeCall(self.OnEnter, self.Value, self)
                else
                    self._invalidUntil = os.clock() + 1.5
                end
            end,
        })
    end
    function element:_onClick() self:_beginInput() end
    function element:_render(context, targetRect)
        if not fullyInsideVertical(targetRect, context.Clip) then return end
        local focused = self._window._focus and self._window._focus.Owner == self
        self:_card(context, targetRect, focused)
        local fieldWidth = clamp(targetRect.W * 0.52, 130, 250)
        self:_label(context, targetRect, fieldWidth + 26)
        local fieldRect = rect(targetRect.X + targetRect.W - fieldWidth - 12, targetRect.Y + floor((targetRect.H - 30) / 2), fieldWidth, 30)
        local field = self:_drawing("textbox:field", "Square", { Filled = true })
        local border = self:_drawing("textbox:border", "Square", { Filled = false })
        local invalid = self._invalidUntil and self._invalidUntil > os.clock()
        showSquare(field, fieldRect, context.Theme.Input, context.Alpha, context.Z + 14)
        showSquare(border, fieldRect, invalid and context.Theme.Error or (focused and context.Theme.Accent or context.Theme.BorderSoft), context.Alpha, context.Z + 15, false, 1)
        local display = focused and self._window._focus.Buffer or tostring(self.Value or "")
        local textDrawing = self:_drawing("textbox:text", "Text")
