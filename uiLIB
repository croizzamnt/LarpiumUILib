function Section:_measure(search)
    if not self.Visible then
        return 0
    end
    local elements = self:_matchingElements(search)
    if search ~= "" and #elements == 0 and not containsInsensitive(self.Name, search) then
        return 0
    end
    local headerHeight = self.Description and 54 or 42
    if self.Collapsed then
        return headerHeight
    end
    local height = headerHeight + 8
    for index, element in ipairs(elements) do
        height = height + element:GetHeight()
        if index < #elements then
            height = height + self._window.Settings.ElementGap
        end
    end
    return height + 10
end

function Tab:_render(context)
    local window = self._window
    local settings = context.Settings
    local clip = context.Clip
    local gap = settings.SectionGap
    local twoColumns = clip.W >= 610
    local columnWidth = twoColumns and floor((clip.W - gap) / 2) or clip.W
    local offsets = { 0, 0 }
    self.Scroll = animateNumber(self.Scroll, self.ScrollTarget, context.Factor)

    for _, section in ipairs(self.Sections) do
        local height = section:_measure(context.Search)
        if height > 0 then
            local column = 1
            local width = columnWidth
            if twoColumns and not section.FullWidth then
                local side = string.lower(section.Side)
                if side == "right" or side == "2" then
                    column = 2
                elseif side == "left" or side == "1" then
                    column = 1
                else
                    column = offsets[1] <= offsets[2] and 1 or 2
                end
            elseif twoColumns and section.FullWidth then
                local shared = max(offsets[1], offsets[2])
                offsets[1], offsets[2] = shared, shared
                width = clip.W
            end
            local x = clip.X + (column - 1) * (columnWidth + gap)
            local logicalY = offsets[column]
            section:_render(context, rect(x, clip.Y + logicalY - self.Scroll, width, height))
            if twoColumns and section.FullWidth then
                offsets[1] = logicalY + height + gap
                offsets[2] = offsets[1]
            else
                offsets[column] = logicalY + height + gap
            end
        end
    end
    self.ContentHeight = max(offsets[1], offsets[2])
    local maximumScroll = max(0, self.ContentHeight - clip.H)
    self.ScrollTarget = clamp(self.ScrollTarget, 0, maximumScroll)
    self.Scroll = clamp(self.Scroll, 0, maximumScroll + 20)
    if maximumScroll > 0 then
        local track = namedDrawing(self, "tab:scrollTrack", "Square", { Filled = true })
        local thumb = namedDrawing(self, "tab:scrollThumb", "Square", { Filled = true })
        showSquare(track, rect(clip.X + clip.W - 3, clip.Y, 3, clip.H), context.Theme.SliderTrack, context.Alpha * 0.65, context.Z + 85)
        local thumbHeight = max(28, clip.H * (clip.H / self.ContentHeight))
        local thumbY = clip.Y + (self.Scroll / maximumScroll) * (clip.H - thumbHeight)
        showSquare(thumb, rect(clip.X + clip.W - 3, thumbY, 3, thumbHeight), context.Theme.Accent, context.Alpha, context.Z + 86)
    end
end

function Section:_render(context, sectionRect)
    local clip = context.Clip
    if not intersects(sectionRect, clip) then
        return
    end
    local visibleTop = max(sectionRect.Y, clip.Y)
    local visibleBottom = min(sectionRect.Y + sectionRect.H, clip.Y + clip.H)
    local clipped = rect(sectionRect.X, visibleTop, sectionRect.W, max(0, visibleBottom - visibleTop))
    local background = namedDrawing(self, "section:background", "Square", { Filled = true })
    local border = namedDrawing(self, "section:border", "Square", { Filled = false })
    showSquare(background, clipped, context.Theme.BackgroundSecondary, context.Alpha, context.Z)
    showSquare(border, clipped, context.Theme.BorderSoft, context.Alpha, context.Z + 1, false, context.Settings.BorderThickness)

    local headerHeight = 42
    local headerRect = rect(sectionRect.X, sectionRect.Y, sectionRect.W, headerHeight)
    self._headerRect = headerRect
    if fullyInsideVertical(headerRect, clip) then
        local header = namedDrawing(self, "section:header", "Square", { Filled = true })
        showSquare(header, headerRect, context.Theme.Header, context.Alpha, context.Z + 2)
        local textX = headerRect.X + 12
        if self.Icon then
            renderIcon(self, "section:icon", self.Icon, vector(textX, headerRect.Y + 12), 16, context.Theme.Accent, context.Alpha, context.Z + 5)
            textX = textX + 25
        end
        local title = namedDrawing(self, "section:title", "Text")
        showText(title, trimText(self.Name, headerRect.W - (textX - headerRect.X) - 46, context.Settings.FontSize + 1), vector(textX, headerRect.Y + 13), context.Theme.Text, context.Settings.FontSize + 1, context.Settings.Font, context.Alpha, context.Z + 5)
        if self.Collapsible then
            local arrow = namedDrawing(self, "section:arrow", "Text")
            showText(arrow, self.Collapsed and ">" or "v", vector(headerRect.X + headerRect.W - 20, headerRect.Y + 13), context.Theme.TextSecondary, context.Settings.FontSize, context.Settings.Font, context.Alpha, context.Z + 6, true)
            self._region.Rect = headerRect
            self._region.Z = context.Z + 40
            registerRegion(self._window, self._region)
        end
    end
    if self.Collapsed then
        return
    end

    local y = sectionRect.Y + headerHeight + 8
    local elements = self:_matchingElements(context.Search)
    for _, element in ipairs(elements) do
        local elementRect = rect(sectionRect.X + 8, y, sectionRect.W - 16, element:GetHeight())
        element:_render(context, elementRect)
        y = y + elementRect.H + context.Settings.ElementGap
    end
end

local function makeElement(section, kind, options, defaultValue, height)
    options = options or {}
    local window = section._window
    local serial = #window._elements + 1
    local persistent = options.IgnoreConfig ~= true and kind ~= "Button" and kind ~= "LogViewer"
    local element = setmetatable({
        Id = tostring(options.Id or options.ID or options.Flag or (string.lower(kind) .. "_" .. serial)),
        Type = kind,
        Name = tostring(options.Name or options.Title or kind),
        Description = options.Description and tostring(options.Description) or nil,
        Tooltip = options.Tooltip and tostring(options.Tooltip) or (options.Description and tostring(options.Description) or nil),
        Icon = options.Icon,
        Flag = options.Flag or (persistent and (string.lower(kind) .. "_" .. serial) or nil),
        Value = options.Default ~= nil and copy(options.Default) or copy(defaultValue),
        Default = options.Default ~= nil and copy(options.Default) or copy(defaultValue),
        Callback = options.Callback,
        Disabled = options.Disabled == true,
        Visible = options.Visible ~= false,
        IgnoreConfig = not persistent,
        Height = options.Height or height or 48,
        _window = window,
        _section = section,
        _namedDrawings = {},
        _regions = {},
        _hover = 0,
        _active = 0,
        _destroyed = false,
        Order = tonumber(options.Order) or serial,
    }, Element)
    element._mainRegion = {
        Z = 0,
        OnBegan = function(input, position)
            if not element.Disabled and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                element:_onClick(position, input)
            elseif not element.Disabled and input.UserInputType == Enum.UserInputType.MouseButton2 and element._onSecondaryClick then
                element:_onSecondaryClick(position, input)
            end
        end,
    }
    table.insert(section.Elements, element)
    window:_registerElement(element)
    return element
end

