local notificationColors = {
    info = "Info", success = "Success", warning = "Warning", error = "Error",
}

function Window:Notify(options)
    if type(options) == "string" then options = { Title = options } end
    options = options or {}
    local notification = {
        Title = tostring(options.Title or "Notification"),
        Description = tostring(options.Description or options.Text or ""),
        Type = string.lower(tostring(options.Type or "Info")),
        Duration = max(0.5, tonumber(options.Duration) or 4),
        CreatedAt = os.clock(),
        Progress = 0,
        Dismissed = false,
        _window = self,
        _namedDrawings = {},
    }
    notification.Region = {
        Z = 0,
        OnBegan = function(input, pointerOrigin)
            if isPrimaryPointer(input) and notification._lastRect then
                local origin = notification.CustomPosition or vector(notification._lastRect.X, notification._lastRect.Y)
                local moved = false
                Library:_capturePointer(self, function(current)
                    if (current - pointerOrigin).Magnitude > 3 then moved = true end
                    notification.CustomPosition = origin + (current - pointerOrigin)
                end, function()
                    if not moved then notification.Dismissed = true end
                end)
            end
        end,
    }
    function notification:Dismiss() self.Dismissed = true end
    table.insert(self._notifications, notification)
    return notification
end

function Library:Notify(options)
    local window = options and options.Window or self:_topWindowAt(self._mouse, true)
    if not window then
        for index = #self.Windows, 1, -1 do
            if not self.Windows[index]._destroyed then window = self.Windows[index] break end
        end
    end
    return window and window:Notify(options)
end

function Window:_releaseOwnerDrawings(owner)
    local handled = {}
    for _, drawing in pairs(owner._namedDrawings or {}) do
        if drawing and not handled[drawing] then
            handled[drawing] = true
            removeDrawing(drawing)
            local index = table.find(self._drawings, drawing)
            if index then table.remove(self._drawings, index) end
        end
    end
    table.clear(owner._namedDrawings or {})
end

function Window:_renderNotifications(deltaTime, zIndex, alpha)
    local viewport = viewportSize()
    local width = min(340, viewport.X - 24)
    local y = viewport.Y - 18
    for index = #self._notifications, 1, -1 do
        local notification = self._notifications[index]
        local elapsed = os.clock() - notification.CreatedAt
        if notification.Dismissed or elapsed >= notification.Duration then
            self:_releaseOwnerDrawings(notification)
            table.remove(self._notifications, index)
        else
            notification.Progress = animateNumber(notification.Progress, 1, animationFactor(self.Settings, deltaTime))
            local lines = wrappedLines(notification.Description, 43, 2)
            local height = notification.Description ~= "" and (62 + (#lines - 1) * 15) or 48
            y = y - height
            local stackY = y
            local x = viewport.X - width - 14 + (1 - notification.Progress) * 28
            if notification.CustomPosition then
                x = clamp(notification.CustomPosition.X, 0, viewport.X - width)
                y = clamp(notification.CustomPosition.Y, 0, viewport.Y - height)
            end
            local cardRect = rect(x, y, width, height)
            notification._lastRect = cardRect
            local notifPrefix = "notification:" .. index .. ":"
            if not notification._round then
                notification._round = RoundRect.new(self, notifPrefix)
            end
            notification._round:Set(vector(x, y), vector(width, height), self.Settings.Radius, self.Theme.Popup, alpha * notification.Progress, zIndex + index * 4, true)
            local border = namedDrawing(notification, notifPrefix .. "border", "Square", { Filled = false })
            showSquare(border, cardRect, self.Theme.Border, alpha * notification.Progress, zIndex + index * 4 + 1, false, 1)
            local token = notificationColors[notification.Type] or "Info"
            local accentColor = self.Theme[token] or self.Theme.Info
            local accent = namedDrawing(notification, notifPrefix .. "accent", "Square", { Filled = true })
            showSquare(accent, rect(x, y, 3, height), accentColor, alpha, zIndex + index * 4 + 2)
            local iconMap = { Info = "info", Success = "check", Warning = "alert_triangle", Error = "x" }
            local notifIcon = iconMap[notification.Type] or "info"
            renderIcon(notification, notifPrefix .. "icon", notifIcon, vector(x + 12, y + 10), 15, accentColor, alpha, zIndex + index * 4 + 3)
            local title = namedDrawing(notification, notifPrefix .. "title", "Text")
            showText(title, trimText(notification.Title, width - 58, self.Settings.FontSize), vector(x + 30, y + 10), self.Theme.Text, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + index * 4 + 3)
            for lineIndex, line in ipairs(lines) do
                if notification.Description ~= "" then
                    local lineDrawing = namedDrawing(notification, notifPrefix .. "line:" .. lineIndex, "Text")
                    showText(lineDrawing, line, vector(x + 30, y + 31 + (lineIndex - 1) * 15), self.Theme.TextSecondary, self.Settings.SmallFontSize, self.Settings.Font, alpha, zIndex + index * 4 + 3)
                end
            end
            local progress = clamp(1 - elapsed / notification.Duration, 0, 1)
            local progressDrawing = namedDrawing(notification, "notification:progress", "Square", { Filled = true })
            showSquare(progressDrawing, rect(x, y + height - 2, width * progress, 2), accentColor, alpha, zIndex + index * 4 + 4)
            notification.Region.Rect = cardRect
            notification.Region.Z = zIndex + index * 4 + 20
            registerRegion(self, notification.Region)
            y = stackY - 8
        end
    end
end

function Window:_renderTooltip(zIndex, alpha)
    local candidate = self._tooltipCandidate
    if candidate ~= self._tooltipOwner then
        self._tooltipOwner = candidate
        self._tooltipSince = os.clock()
    end
    if not candidate or os.clock() - self._tooltipSince < self.Settings.TooltipDelay then return end
    local text = candidate.Tooltip
    local lines = wrappedLines(text, 46, 3)
    local width = 0
    for _, line in ipairs(lines) do width = max(width, estimateTextWidth(line, self.Settings.SmallFontSize)) end
    width = clamp(width + 24, 90, 320)
    local height = 16 + #lines * 15
    local viewport = viewportSize()
    local x = clamp(Library._mouse.X + 14, 6, viewport.X - width - 6)
    local y = clamp(Library._mouse.Y + 18, 6, viewport.Y - height - 6)
    if not self._tooltipRound then
        self._tooltipRound = RoundRect.new(self, "tooltip")
    end
    self._tooltipRound:Set(vector(x, y), vector(width, height), self.Settings.Radius, self.Theme.Popup, alpha, zIndex, true)
    local border = namedDrawing(self, "tooltip:border", "Square", { Filled = false })
