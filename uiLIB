function Library:CreateTheme(name, tokens)
    assert(type(name) == "string" and name ~= "", "Theme name is required")
    assert(type(tokens) == "table", "Theme tokens must be a table")
    self.Themes[name] = merge(copy(self.DefaultTheme), validatedThemePatch(tokens, self.DefaultTheme))
    return self.Themes[name]
end

function Library:SetTheme(theme)
    local nextTheme
    if type(theme) == "string" then
        assert(self.Themes[theme], "Unknown theme: " .. theme)
        nextTheme = copy(self.Themes[theme])
    else
        assert(type(theme) == "table", "SetTheme expects a theme name or token table")
        nextTheme = merge(copy(self.Theme), validatedThemePatch(theme, self.Theme))
    end
    self.Theme = nextTheme
    for _, window in ipairs(self.Windows) do
        if not window._destroyed then
            window.Theme = merge(copy(nextTheme), window._themePatch)
            if window._syncConfigControls then window:_syncConfigControls() end
        end
    end
    return self
end

function Library:SetSettings(settings)
    assert(type(settings) == "table", "SetSettings expects a table")
    settings = validatedSettingsPatch(settings)
    merge(self.Settings, settings)
    for _, window in ipairs(self.Windows) do
        if not window._destroyed then merge(window.Settings, settings) end
    end
    return self
end

function Library:GetWindow(id)
    for _, window in ipairs(self.Windows) do
        if window.Id == id then return window end
    end
end

function Library:GetFlag(flag, window)
    if type(window) == "string" then window = self:GetWindow(window) end
    if type(window) == "table" and window.Flags then return window.Flags[flag] end
    if #self.Windows == 1 then return self.Windows[1].Flags[flag] end
    return nil
end

function Library:SetFlag(flag, value, window, silent)
    if type(window) == "string" then window = self:GetWindow(window) end
    if type(window) == "table" and window.SetFlag then return window:SetFlag(flag, value, silent) end
    if #self.Windows == 1 then return self.Windows[1]:SetFlag(flag, value, silent) end
    return nil, "A target window is required when multiple windows exist."
end

function Tab:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    local sections = shallowArrayCopy(self.Sections)
    for _, section in ipairs(sections) do section:Destroy() end
    self._window:_releaseOwnerDrawings(self)
    local index = table.find(self._window.Tabs, self)
    if index then table.remove(self._window.Tabs, index) end
    if self._window.ActiveTab == self then
        self._window.ActiveTab = nil
        for _, candidate in ipairs(self._window.Tabs) do
            if candidate.Visible and not candidate._destroyed then self._window.ActiveTab = candidate break end
        end
    end
end

function Section:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    local elements = shallowArrayCopy(self.Elements)
    for _, element in ipairs(elements) do element:Destroy() end
    self._window:_releaseOwnerDrawings(self)
    local index = table.find(self._tab.Sections, self)
    if index then table.remove(self._tab.Sections, index) end
end

function Window:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    self:_releaseHeldKeybinds()
    self.Visible = false
    if Library._pointerCapture and Library._pointerCapture.Window == self then Library._pointerCapture = nil end
    local tabs = shallowArrayCopy(self.Tabs)
    for _, tab in ipairs(tabs) do tab:Destroy() end
    local drawings = shallowArrayCopy(self._drawings)
    for _, drawing in ipairs(drawings) do removeDrawing(drawing) end
    table.clear(self._drawings)
    table.clear(self._namedDrawings)
    table.clear(self._regions)
    table.clear(self._notifications)
    table.clear(self._elements)
    table.clear(self._elementByFlag)
    table.clear(self._hotkeys)
    local index = table.find(Library.Windows, self)
    if index then table.remove(Library.Windows, index) end
    if Library.Flags[self.Id] == self.Flags then Library.Flags[self.Id] = nil end
end

Window.Unload = Window.Destroy
Window.Close = function(self) return self:SetVisible(false) end

function Library:Unload()
    local windows = shallowArrayCopy(self.Windows)
    for _, window in ipairs(windows) do window:Destroy() end
    for _, connection in ipairs(self._connections) do disconnect(connection) end
    table.clear(self._connections)
    table.clear(self.Windows)
    table.clear(self.Flags)
    self._pointerCapture = nil
    self._started = false
    self._destroyed = true
end

Library.Destroy = Library.Unload
Library.CheckCapabilities = Library.GetCapabilities
Library.Create = Library.CreateWindow

pcall(function() Library:LoadSavedThemes() end)

return Library
