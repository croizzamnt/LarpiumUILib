function Window:Prompt(options)
    options = options or {}
    self._overlay = nil
    self:_clearFocus(true)
    local modal = {
        Title = tostring(options.Title or "Confirm action"),
        Description = tostring(options.Description or options.Text or "Are you sure?"),
        ConfirmText = tostring(options.ConfirmText or options.YesText or "Confirm"),
        CancelText = tostring(options.CancelText or options.NoText or "Cancel"),
        OnConfirm = options.OnConfirm or options.Callback,
        OnCancel = options.OnCancel,
        Destructive = options.Destructive == true,
        Progress = 0,
        Position = options.Position and optionVector(options.Position, vector(0, 0)) or nil,
        Draggable = options.Draggable ~= false,
    }
    local function close(confirmed)
        if self._modal ~= modal then return end
        self._modal = nil
        if confirmed then safeCall(modal.OnConfirm, true) else safeCall(modal.OnCancel, false) end
    end
    modal.BlockRegion = { Z = 0, OnBegan = function() end }
    modal.DragRegion = {
        Z = 0,
        OnBegan = function(input, pointerOrigin)
            if isPrimaryPointer(input) and modal.Draggable and modal.Position then
                local positionOrigin = modal.Position
                Library:_capturePointer(self, function(current)
                    modal.Position = positionOrigin + (current - pointerOrigin)
                end)
            end
        end,
    }
    modal.ConfirmRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then close(true) end
        end,
    }
    modal.CancelRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then close(false) end
        end,
    }
    modal.Close = close
    self._modal = modal
    return modal
end

