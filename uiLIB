function Window:_collectKeybinds()
    local result = {}
    for _, element in ipairs(self._hotkeys) do
        if not element._destroyed and element.ShowInList ~= false then
            local key, mode, active
            if element.Type == "Toggle" then
                key, mode, active = element.Key, element.KeyMode, element.Value
            elseif element.Type == "Keybind" then
                key, mode, active = element.Value, element.Mode, element.Active
            end
            local unbound = key == nil or enumName(key) == "Unknown" or enumName(key) == "None"
            if key and (not unbound or (self._keybindList and self._keybindList.ShowUnbound)) then
                if active or not self._keybindList or self._keybindList.ShowInactive then
                    table.insert(result, {
                        Id = element.Id,
                        Name = element.Name,
                        Key = key,
                        Mode = mode or "Toggle",
                        Active = active == true,
                        Order = element.Order or 0,
                        Owner = element,
                    })
                end
            end
        end
    end
    table.sort(result, function(a, b)
        if a.Order == b.Order then return a.Name < b.Name end
        return a.Order < b.Order
    end)
    return result
end

function Window:_renderKeybindList(zIndex, alpha)
    local widget = self._keybindList
    if not widget or not widget.Visible then return end
    local bindings = self:_collectKeybinds()
    local rowCount = min(widget.MaxVisibleRows, max(1, #bindings))
    local width = 230
    for _, binding in ipairs(bindings) do
        width = max(width, estimateTextWidth(binding.Name, self.Settings.SmallFontSize) + estimateTextWidth(enumName(binding.Key) .. "  " .. binding.Mode, self.Settings.SmallFontSize) + 62)
    end
    width = min(width, 340)
    local headerHeight, rowHeight = 32, 30
    local height = headerHeight + rowCount * rowHeight + 6
    local viewport = viewportSize()
    if not widget._positionReady then
        widget.Position = string.lower(widget.Anchor) == "topleft" and vector(14, 58) or vector(viewport.X - width - 14, 58)
        widget._positionReady = true
    end
    widget.Position = vector(clamp(widget.Position.X, 0, viewport.X - width), clamp(widget.Position.Y, 0, viewport.Y - height))
    local bounds = rect(widget.Position.X, widget.Position.Y, width, height)
    widget.Bounds = bounds
    local background = namedDrawing(widget, "keylist:background", "Square", { Filled = true })
    local border = namedDrawing(widget, "keylist:border", "Square", { Filled = false })
    local header = namedDrawing(widget, "keylist:header", "Square", { Filled = true })
    showSquare(background, bounds, self.Theme.Popup, alpha * 0.94, zIndex)
    showSquare(border, bounds, self.Theme.Border, alpha, zIndex + 1, false, 1)
    showSquare(header, rect(bounds.X, bounds.Y, bounds.W, headerHeight), self.Theme.Header, alpha, zIndex + 2)
    local title = namedDrawing(widget, "keylist:title", "Text")
    renderIcon(widget, "keylist:icon", "keyboard", vector(bounds.X + 11, bounds.Y + 9), 16, self.Theme.Accent, alpha, zIndex + 4)
    showText(title, widget.Title, vector(bounds.X + 30, bounds.Y + 9), self.Theme.Text, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 4, false, true)
    local count = namedDrawing(widget, "keylist:count", "Text")
    showText(count, tostring(#bindings), vector(bounds.X + bounds.W - 18, bounds.Y + 9), self.Theme.TextSecondary, self.Settings.SmallFontSize, self.Settings.Font, alpha, zIndex + 4, true, true)
    widget.HeaderRegion.Rect = rect(bounds.X, bounds.Y, bounds.W, headerHeight)
    widget.HeaderRegion.Z = zIndex + 20
    registerRegion(self, widget.HeaderRegion)
    widget.WheelRegion.Rect = bounds
    widget.WheelRegion.Z = zIndex + 10
    registerRegion(self, widget.WheelRegion)
    local maxScroll = max(0, #bindings - widget.MaxVisibleRows)
    widget.Scroll = clamp(floor(widget.Scroll + 0.5), 0, maxScroll)
    if #bindings == 0 then
        local empty = namedDrawing(widget, "keylist:empty", "Text")
        showText(empty, "No keybinds assigned", vector(bounds.X + 11, bounds.Y + headerHeight + 8), self.Theme.TextDisabled, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 4, false, true)
        return
    end
    for visualIndex = 1, widget.MaxVisibleRows do
        local binding = bindings[widget.Scroll + visualIndex]
        if not binding then break end
        local rowRect = rect(bounds.X + 5, bounds.Y + headerHeight + (visualIndex - 1) * rowHeight + 3, bounds.W - 10, rowHeight - 2)
        local hovered = pointIn(Library._mouse, rowRect)
        if hovered then
            local rowBackground = namedDrawing(widget, "keylist:rowBg:" .. visualIndex, "Square", { Filled = true })
            showSquare(rowBackground, rowRect, self.Theme.CardHover, alpha, zIndex + 3)
        end
        if binding.Active then
            local dot = namedDrawing(widget, "keylist:dot:" .. visualIndex, "Circle", { Filled = true, NumSides = 16 })
            setDrawing(dot, {
                Position = vector(rowRect.X + 7, rowRect.Y + rowRect.H / 2), Radius = 3.5, NumSides = 16,
                Thickness = 1, Filled = true, Color = self.Theme.Accent, Transparency = alpha,
                ZIndex = zIndex + 6, Visible = true,
            })
        end
        local name = namedDrawing(widget, "keylist:name:" .. visualIndex, "Text")
        showText(name, trimText(binding.Name, rowRect.W * 0.55, self.Settings.FontSize), vector(rowRect.X + 16, rowRect.Y + 7), binding.Active and self.Theme.Accent or self.Theme.Text, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 6, false, true)
        local suffixMode = string.lower(binding.Mode) == "hold" and "Hold" or (string.lower(binding.Mode) == "always" and "Always" or "Toggle")
        local suffix = enumName(binding.Key) .. "  " .. suffixMode
        local suffixDrawing = namedDrawing(widget, "keylist:suffix:" .. visualIndex, "Text")
        showText(suffixDrawing, suffix, vector(rowRect.X + rowRect.W - estimateTextWidth(suffix, self.Settings.SmallFontSize) - 7, rowRect.Y + 7), binding.Active and self.Theme.Accent or self.Theme.TextSecondary, self.Settings.SmallFontSize, self.Settings.Font, alpha, zIndex + 6, false, true)
        local region = widget.RowRegions[visualIndex]
        if not region then
            region = {
                Z = 0,
                OnBegan = function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton2 and region.Binding then
                        local owner = region.Binding.Owner
                        if owner._onSecondaryClick then owner:_onSecondaryClick() end
                    end
                end,
            }
            widget.RowRegions[visualIndex] = region
        end
        region.Binding = binding
        region.Rect = rowRect
        region.Z = zIndex + 25
        registerRegion(self, region)
    end
end

