    for index, line in ipairs(lines) do
        local drawing = namedDrawing(self, "tooltip:line:" .. index, "Text")
        showText(drawing, line, vector(x + 12, y + 8 + (index - 1) * 15), self.Theme.TextSecondary, self.Settings.SmallFontSize, self.Settings.Font, alpha, zIndex + 2)
    end
end

function Window:SetWatermark(options)
    if type(options) == "string" then options = { Text = options } end
    options = options or {}
    local watermark = self._watermark or {
        _window = self,
        _namedDrawings = {},
        Fields = {
            Username = true,
            GameName = true,
            GameId = false,
            PlaceId = false,
            FPS = true,
            Ping = true,
            PlayerCount = true,
            Clock = true,
        },
        CustomFields = {},
    }
    watermark.Text = tostring(options.Text or options.Name or watermark.Text or (self.Title .. " | " .. Library.Version))
    watermark.Dynamic = options.Dynamic == true or (options.Dynamic == nil and watermark.Dynamic == true)
    if options.Visible ~= nil then watermark.Visible = options.Visible == true elseif watermark.Visible == nil then watermark.Visible = true end
    if options.Draggable ~= nil then watermark.Draggable = options.Draggable == true elseif watermark.Draggable == nil then watermark.Draggable = true end
    if options.FollowWindowVisibility ~= nil then
        watermark.FollowWindowVisibility = options.FollowWindowVisibility == true
    elseif watermark.FollowWindowVisibility == nil then
        watermark.FollowWindowVisibility = false
    end
    watermark.Anchor = tostring(options.Anchor or watermark.Anchor or "TopRight")
    watermark.UpdateInterval = max(0.1, tonumber(options.UpdateInterval) or watermark.UpdateInterval or 0.25)
    watermark.Separator = tostring(options.Separator or watermark.Separator or "  |  ")
    if options.Fields then merge(watermark.Fields, options.Fields) end
    if options.CustomFields then watermark.CustomFields = shallowArrayCopy(options.CustomFields) end
    if options.Position then
        watermark.Position = optionVector(options.Position, vector(14, 14))
        watermark.Anchor = tostring(options.Anchor or "Free")
        watermark._positionReady = string.lower(watermark.Anchor) == "free"
    elseif not watermark.Position then
        watermark.Position = vector(14, 14)
        watermark._positionReady = false
    end
    if not watermark.Region then
        watermark.Region = {
            Z = 0,
            OnBegan = function(input, positionAtStart)
                if isPrimaryPointer(input) and watermark.Draggable then
                    local origin = watermark.Position
                    Library:_capturePointer(self, function(current)
                        watermark.Position = origin + (current - positionAtStart)
                        watermark.Anchor = "Free"
                        watermark._positionReady = true
                    end)
                end
            end,
        }
    end
    function watermark:SetVisible(visible) self.Visible = visible == true return self end
    function watermark:Toggle() self.Visible = not self.Visible return self end
    function watermark:SetPosition(position) self.Position = optionVector(position, self.Position); self.Anchor = "Free"; self._positionReady = true return self end
    function watermark:SetAnchor(anchor) self.Anchor = tostring(anchor or "TopRight"); self._positionReady = false return self end
    function watermark:SetDraggable(enabled) self.Draggable = enabled == true return self end
    function watermark:SetFieldVisible(field, visible) self.Fields[field] = visible == true; self._lastUpdate = 0 return self end
    function watermark:SetText(text) self.Text = tostring(text); self.Dynamic = false return self end
    function watermark:Refresh() self._lastUpdate = 0 return self end
    function watermark:GetBounds() return self.Bounds end
    function watermark:Destroy()
        self.Visible = false
        self._window:_releaseOwnerDrawings(self)
        if self._window._watermark == self then self._window._watermark = nil end
    end
    self._watermark = watermark
    return watermark
end

