function Section:AddDropdown(options)
    options = options or {}
    local choices = normalizeOptions(options.Options or options.Values or {})
    local multi = options.Multi == true or options.Multiple == true
    local fallback = multi and {} or firstEnabledValue(choices)
    local element = makeElement(self, multi and "MultiDropdown" or "Dropdown", options, fallback, 48)
    element.Options = choices
    element.Multi = multi
    element.MaxVisible = max(1, floor(tonumber(options.MaxVisible) or 7))
    function element:_coerce(value)
        if self.Multi then
            local selected = {}
            if type(value) == "table" then
                for _, candidate in ipairs(value) do
                    for _, option in ipairs(self.Options) do
                        if option.Value == candidate and not option.Disabled and not hasValue(selected, candidate) then
                            table.insert(selected, candidate)
                        end
                    end
                end
            end
            return selected
        end
        for _, option in ipairs(self.Options) do
            if option.Value == value and not option.Disabled then return value end
        end
        return firstEnabledValue(self.Options)
    end
    element.Value = element:_coerce(element.Value)
    function element:SetOptions(newOptions, preserve)
        self.Options = normalizeOptions(newOptions)
        if preserve then
            self:Set(self.Value, true)
        else
            self:Set(self.Multi and {} or firstEnabledValue(self.Options), true)
        end
        return self
    end
    element.Refresh = element.SetOptions
    function element:Add(option)
        local normalized = normalizeOptions({ option })
        if normalized[1] then table.insert(self.Options, normalized[1]) end
        return self
    end
    function element:Remove(value)
        for index = #self.Options, 1, -1 do
            if self.Options[index].Value == value or self.Options[index].Label == value then
                table.remove(self.Options, index)
            end
        end
        self:Set(self.Value, true)
        return self
    end
    function element:_selectOption(option)
        if option.Disabled then return end
        if self.Multi then
            local selected = shallowArrayCopy(self.Value)
            if hasValue(selected, option.Value) then
                removeValue(selected, option.Value)
            else
                table.insert(selected, option.Value)
            end
            self:Set(selected)
        else
            self:Set(option.Value)
            self._window._overlay = nil
            self._window:_clearFocus(true)
        end
    end
    function element:_onClick()
        if self._window._overlay and self._window._overlay.Kind == "Dropdown" and self._window._overlay.Owner == self then
            self._window._overlay = nil
            self._window:_clearFocus(true)
        else
            self._window:_openDropdown(self)
        end
    end
    function element:_caption()
        if self.Multi then
            if #self.Value == 0 then return "Select..." end
            local labels = {}
            for _, value in ipairs(self.Value) do table.insert(labels, optionLabel(self.Options, value)) end
            return table.concat(labels, ", ")
        end
        return self.Value ~= nil and optionLabel(self.Options, self.Value) or "Select..."
    end
    function element:_render(context, targetRect)
        if not fullyInsideVertical(targetRect, context.Clip) then return end
        local open = self._window._overlay and self._window._overlay.Kind == "Dropdown" and self._window._overlay.Owner == self
        self:_card(context, targetRect, open)
        self:_label(context, targetRect, floor(targetRect.W * 0.58))
        local fieldWidth = clamp(targetRect.W * 0.48, 120, 220)
        local fieldRect = rect(targetRect.X + targetRect.W - fieldWidth - 12, targetRect.Y + floor((targetRect.H - 28) / 2), fieldWidth, 28)
        local field = self:_drawing("dropdown:field", "Square", { Filled = true })
        showSquare(field, fieldRect, context.Theme.Input, context.Alpha, context.Z + 14)
        local caption = self:_drawing("dropdown:caption", "Text")
        showText(caption, trimText(self:_caption(), fieldWidth - 30, context.Settings.SmallFontSize), vector(fieldRect.X + 10, fieldRect.Y + 7), self.Value ~= nil and context.Theme.TextSecondary or context.Theme.TextDisabled, context.Settings.SmallFontSize, context.Settings.Font, context.Alpha, context.Z + 16)
        local arrow = self:_drawing("dropdown:arrow", "Text")
        showText(arrow, open and "^" or "v", vector(fieldRect.X + fieldRect.W - 14, fieldRect.Y + 6), context.Theme.TextSecondary, context.Settings.SmallFontSize, context.Settings.Font, context.Alpha, context.Z + 16, true)
        self._anchorRect = fieldRect
        self:_registerMain(context, targetRect)
    end
    if element.Flag then self._window.Flags[element.Flag] = element.Value end
    return element
