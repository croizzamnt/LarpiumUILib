    local border = self:_drawing("element:border", "Square", { Filled = false })
    showSquare(border, targetRect, selected and context.Theme.AccentMuted or context.Theme.BorderSoft, cardAlpha, context.Z + 6, false, context.Settings.BorderThickness)
