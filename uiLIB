function Window:_watermarkText(watermark)
    if not watermark.Dynamic then return watermark.Text end
    local now = os.clock()
    if watermark._cachedText and now - (watermark._lastUpdate or 0) < watermark.UpdateInterval then
        return watermark._cachedText
    end
    watermark._lastUpdate = now
    local fields = watermark.Fields
    local parts = {}
    local player = Players.LocalPlayer
    if fields.Username then
        table.insert(parts, player and (player.DisplayName .. " (@" .. player.Name .. ")") or "Player: N/A")
    end
    if fields.GameName then
        Library:_requestGameName()
        table.insert(parts, tostring(Library._gameName or game.Name or "Game"))
    end
    if fields.GameId then table.insert(parts, "Game " .. tostring(game.GameId)) end
    if fields.PlaceId then table.insert(parts, "Place " .. tostring(game.PlaceId)) end
    if fields.FPS then table.insert(parts, tostring(floor((self._fps or 0) + 0.5)) .. " FPS") end
    if fields.Ping then table.insert(parts, readPing()) end
    if fields.PlayerCount then table.insert(parts, tostring(#Players:GetPlayers()) .. " players") end
    if fields.Clock then table.insert(parts, os.date("%H:%M:%S")) end
    for _, customField in ipairs(watermark.CustomFields or {}) do
        if customField.Visible ~= false and type(customField.GetValue) == "function" then
            local interval = max(0.1, tonumber(customField.UpdateInterval) or watermark.UpdateInterval)
            if not customField._running and now - (customField._lastUpdate or 0) >= interval then
                customField._running = true
                customField._lastUpdate = now
                task.spawn(function()
                    local ok, value = safeCall(customField.GetValue, self, watermark)
                    customField._value = ok and tostring(value) or "N/A"
                    customField._running = false
                    watermark._lastUpdate = 0
                end)
            end
            local label = customField.Label and (tostring(customField.Label) .. " ") or ""
            table.insert(parts, label .. tostring(customField._value or "..."))
        end
    end
    watermark._cachedText = table.concat(parts, watermark.Separator)
    return watermark._cachedText
end

