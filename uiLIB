function Window:_openDropdown(owner)
    self:_clearFocus(true)
    local overlay = {
        Kind = "Dropdown",
        Owner = owner,
        Search = "",
        Scroll = 0,
        Progress = 0,
        RowRegions = {},
    }
    overlay.SearchRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then
                self:_focusText({
                    Kind = "DropdownSearch", Owner = owner, Buffer = overlay.Search, MaxLength = 64,
                    Change = function(buffer) overlay.Search = buffer; overlay.Scroll = 0 end,
                    Commit = function(buffer) overlay.Search = buffer end,
                })
            end
        end,
    }
    overlay.WheelRegion = {
        Z = 0,
        OnWheel = function(direction)
            overlay.Scroll = max(0, overlay.Scroll - direction)
        end,
        OnBegan = function() end,
    }
    self._overlay = overlay
end

local function pickerValues(owner)
    if owner.Type == "Toggle" then
        return owner.Color, owner.ColorAlpha, true
    end
    return owner.Value, owner.Alpha or 1, owner.AllowAlpha ~= false
end

local function setPickerValues(owner, color, alpha)
    if owner.Type == "Toggle" then
        owner:SetColor(color, alpha)
    else
        owner:Set(color, alpha)
    end
end

function Window:_openColor(owner, anchor)
    self:_clearFocus(true)
    local overlay = {
        Kind = "Color",
        Owner = owner,
        Anchor = anchor,
        Progress = 0,
    }
    overlay.BlockRegion = { Z = 0, OnBegan = function() end }
    local function updateSV(position)
        if not overlay.SVRect then return end
        local color, alpha = pickerValues(owner)
        local hue = select(1, color:ToHSV())
        local saturation = clamp((position.X - overlay.SVRect.X) / overlay.SVRect.W, 0, 1)
        local value = 1 - clamp((position.Y - overlay.SVRect.Y) / overlay.SVRect.H, 0, 1)
        setPickerValues(owner, Color3.fromHSV(hue, saturation, value), alpha)
    end
    local function updateHue(position)
        if not overlay.HueRect then return end
        local color, alpha = pickerValues(owner)
        local _, saturation, value = color:ToHSV()
        local hue = clamp((position.Y - overlay.HueRect.Y) / overlay.HueRect.H, 0, 1)
        setPickerValues(owner, Color3.fromHSV(hue, saturation, value), alpha)
    end
    local function updateAlpha(position)
        if not overlay.AlphaRect then return end
        local color = pickerValues(owner)
        local alpha = clamp((position.X - overlay.AlphaRect.X) / overlay.AlphaRect.W, 0, 1)
        setPickerValues(owner, color, alpha)
    end
    overlay.SVRegion = {
        Z = 0,
        OnBegan = function(input, position)
            if isPrimaryPointer(input) then
                updateSV(position)
                Library:_capturePointer(self, updateSV)
            end
        end,
    }
    overlay.HueRegion = {
        Z = 0,
        OnBegan = function(input, position)
            if isPrimaryPointer(input) then
                updateHue(position)
                Library:_capturePointer(self, updateHue)
            end
        end,
    }
    overlay.AlphaRegion = {
        Z = 0,
        OnBegan = function(input, position)
            if isPrimaryPointer(input) then
                updateAlpha(position)
                Library:_capturePointer(self, updateAlpha)
            end
        end,
    }
    overlay.HexRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then
                local color = pickerValues(owner)
                self:_focusText({
                    Kind = "ColorHex", Owner = owner, Buffer = colorToHex(color), MaxLength = 7,
                    Commit = function(buffer)
                        local parsed = colorFromHex(buffer)
                        if parsed then
                            local _, alpha = pickerValues(owner)
                            setPickerValues(owner, parsed, alpha)
                        end
                    end,
                })
            end
        end,
    }
    overlay.CloseRegion = {
        Z = 0,
        OnBegan = function(input)
            if isPrimaryPointer(input) then
                self:_clearFocus(true)
                self._overlay = nil
            end
        end,
    }
    self._overlay = overlay
end

function Window:_renderOverlay(deltaTime, zIndex, alpha)
    local overlay = self._overlay
    if not overlay then return end
    overlay.Progress = animateNumber(overlay.Progress or 0, 1, animationFactor(self.Settings, deltaTime))
    if overlay.Kind == "Dropdown" then
        self:_renderDropdownOverlay(overlay, zIndex, alpha * overlay.Progress)
    elseif overlay.Kind == "Color" then
        self:_renderColorOverlay(overlay, zIndex, alpha * overlay.Progress)
    end
end

function Window:_renderDropdownOverlay(overlay, zIndex, alpha)
    local owner = overlay.Owner
    if owner._destroyed or not owner.Visible or not owner._anchorRect then
        self._overlay = nil
        return
    end
    local filtered = {}
    for _, option in ipairs(owner.Options) do
        if containsInsensitive(option.Label, overlay.Search) then table.insert(filtered, option) end
    end
    local visibleCount = min(owner.MaxVisible, max(1, #filtered))
    local rowHeight = 29
    local headerHeight = 39
    local popupWidth = max(190, owner._anchorRect.W)
    local popupHeight = headerHeight + visibleCount * rowHeight + 8
    local x = owner._anchorRect.X + owner._anchorRect.W - popupWidth
    local y = owner._anchorRect.Y + owner._anchorRect.H + 5
    local viewport = viewportSize()
    if y + popupHeight > viewport.Y - 8 then y = owner._anchorRect.Y - popupHeight - 5 end
    x = clamp(x, 8, max(8, viewport.X - popupWidth - 8))
    y = clamp(y, 8, max(8, viewport.Y - popupHeight - 8))
    local popupRect = rect(x, y, popupWidth, popupHeight)
    overlay.Rect = popupRect
    if not self._overlayRound then self._overlayRound = RoundRect.new(self, "overlay") end
    self._overlayRound:Set(vector(x, y), vector(popupWidth, popupHeight), self.Settings.Radius, self.Theme.Popup, alpha, zIndex, true)
    local border = namedDrawing(self, "overlay:border", "Square", { Filled = false })
    showSquare(border, popupRect, self.Theme.Border, alpha, zIndex + 2, false, 1)
    local searchRect = rect(x + 8, y + 8, popupWidth - 16, 27)
    local searchBackground = namedDrawing(self, "overlay:dropdown:searchBg", "Square", { Filled = true })
    showSquare(searchBackground, searchRect, self.Theme.Input, alpha, zIndex + 4)
    local focused = self._focus and self._focus.Kind == "DropdownSearch" and self._focus.Owner == owner
    local searchValue = focused and self._focus.Buffer or overlay.Search
    local searchText = namedDrawing(self, "overlay:dropdown:searchText", "Text")
    showText(searchText, searchValue ~= "" and trimText(searchValue, searchRect.W - 16, self.Settings.SmallFontSize) or "Filter options...", vector(searchRect.X + 8, searchRect.Y + 7), searchValue ~= "" and self.Theme.Text or self.Theme.TextDisabled, self.Settings.SmallFontSize, self.Settings.Font, alpha, zIndex + 7)
    overlay.SearchRegion.Rect = searchRect
    overlay.SearchRegion.Z = zIndex + 20
    registerRegion(self, overlay.SearchRegion)
    overlay.WheelRegion.Rect = popupRect
    overlay.WheelRegion.Z = zIndex + 10
    registerRegion(self, overlay.WheelRegion)

    local maxScroll = max(0, #filtered - owner.MaxVisible)
    overlay.Scroll = clamp(floor(overlay.Scroll + 0.5), 0, maxScroll)
    for visualIndex = 1, owner.MaxVisible do
        local optionIndex = overlay.Scroll + visualIndex
        local option = filtered[optionIndex]
        if not option then break end
        local itemRect = rect(x + 8, y + headerHeight + (visualIndex - 1) * rowHeight, popupWidth - 16, rowHeight - 2)
        local selected = owner.Multi and hasValue(owner.Value, option.Value) or owner.Value == option.Value
        local hovered = pointIn(Library._mouse, itemRect)
        local background = namedDrawing(self, "overlay:dropdown:itemBg:" .. visualIndex, "Square", { Filled = true })
        showSquare(background, itemRect, selected and self.Theme.Selection or (hovered and self.Theme.CardHover or self.Theme.Popup), alpha * (option.Disabled and 0.5 or 1), zIndex + 5)
        if selected or hovered then
            local accentBar = namedDrawing(self, "overlay:dropdown:accent:" .. visualIndex, "Square", { Filled = true })
            showSquare(accentBar, rect(itemRect.X, itemRect.Y, 2, itemRect.H), selected and self.Theme.Accent or self.Theme.BorderSoft, alpha, zIndex + 6)
        end
        local textDrawing = namedDrawing(self, "overlay:dropdown:itemText:" .. visualIndex, "Text")
        showText(textDrawing, trimText(option.Label, itemRect.W - 34, self.Settings.FontSize), vector(itemRect.X + 9, itemRect.Y + 6), option.Disabled and self.Theme.TextDisabled or (selected and self.Theme.Text or (hovered and self.Theme.Text or self.Theme.TextSecondary)), self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 8)
        if selected then
            local check = namedDrawing(self, "overlay:dropdown:itemCheck:" .. visualIndex, "Text")
            showText(check, "x", vector(itemRect.X + itemRect.W - 15, itemRect.Y + 6), self.Theme.Accent, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 9, true)
        end
        local region = overlay.RowRegions[visualIndex]
        if not region then
            region = {
                Z = 0,
                OnBegan = function(input)
                    if isPrimaryPointer(input) and region.Option then
                        owner:_selectOption(region.Option)
                    end
                end,
            }
            overlay.RowRegions[visualIndex] = region
        end
        region.Rect = itemRect
        region.Option = option
        region.Z = zIndex + 25
        registerRegion(self, region)
    end
end

function Window:_renderColorOverlay(overlay, zIndex, alpha)
    local owner = overlay.Owner
    if owner._destroyed then self._overlay = nil return end
    local color, colorAlpha, allowAlpha = pickerValues(owner)
    local hue, saturation, value = color:ToHSV()
    local width, height = 302, allowAlpha and 284 or 254
    local anchor = overlay.Anchor or owner._lastRect or rect(self._position.X, self._position.Y, 0, 0)
    local x = anchor.X + anchor.W - width
    local y = anchor.Y + anchor.H + 5
    local viewport = viewportSize()
    if y + height > viewport.Y - 8 then y = anchor.Y - height - 5 end
    x = clamp(x, 8, max(8, viewport.X - width - 8))
    y = clamp(y, 8, max(8, viewport.Y - height - 8))
    local popupRect = rect(x, y, width, height)
    overlay.Rect = popupRect
    overlay.BlockRegion.Rect = popupRect
    overlay.BlockRegion.Z = zIndex + 10
    registerRegion(self, overlay.BlockRegion)
    if not self._overlayRound then self._overlayRound = RoundRect.new(self, "overlay") end
    self._overlayRound:Set(vector(x, y), vector(width, height), self.Settings.Radius, self.Theme.Popup, alpha, zIndex, true)
    local border = namedDrawing(self, "overlay:border", "Square", { Filled = false })
    showSquare(border, popupRect, self.Theme.Border, alpha, zIndex + 2, false, 1)
    local title = namedDrawing(self, "overlay:color:title", "Text")
    showText(title, owner.Name or "Color", vector(x + 12, y + 10), self.Theme.Text, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 8)
    local close = namedDrawing(self, "overlay:color:close", "Text")
    showText(close, "x", vector(x + width - 17, y + 9), self.Theme.TextSecondary, self.Settings.FontSize, self.Settings.Font, alpha, zIndex + 8, true)
    overlay.CloseRegion.Rect = rect(x + width - 32, y + 3, 29, 28)
    overlay.CloseRegion.Z = zIndex + 30
    registerRegion(self, overlay.CloseRegion)

    local svRect = rect(x + 12, y + 36, width - 50, 142)
    overlay.SVRect = svRect
    local columns, rows = 12, 10
    for row = 1, rows do
        for column = 1, columns do
            local index = (row - 1) * columns + column
            local cell = namedDrawing(self, "overlay:color:sv:" .. index, "Square", { Filled = true })
            local cellRect = rect(
                svRect.X + (column - 1) * svRect.W / columns,
                svRect.Y + (row - 1) * svRect.H / rows,
                svRect.W / columns + 1,
                svRect.H / rows + 1
            )
            showSquare(cell, cellRect, Color3.fromHSV(hue, (column - 1) / (columns - 1), 1 - (row - 1) / (rows - 1)), alpha, zIndex + 5)
        end
    end
    local selector = namedDrawing(self, "overlay:color:svSelector", "Circle", { Filled = false, NumSides = 18 })
    setDrawing(selector, {
        Position = vector(svRect.X + saturation * svRect.W, svRect.Y + (1 - value) * svRect.H),
        Radius = 5, NumSides = 18, Filled = false, Thickness = 2, Color = self.Theme.Text,
        Transparency = alpha, ZIndex = zIndex + 12, Visible = true,
    })
    overlay.SVRegion.Rect = svRect
    overlay.SVRegion.Z = zIndex + 25
    registerRegion(self, overlay.SVRegion)

    local hueRect = rect(svRect.X + svRect.W + 10, svRect.Y, 16, svRect.H)
    overlay.HueRect = hueRect
    local hueSegments = 18
    for index = 1, hueSegments do
        local segment = namedDrawing(self, "overlay:color:hue:" .. index, "Square", { Filled = true })
        showSquare(segment, rect(hueRect.X, hueRect.Y + (index - 1) * hueRect.H / hueSegments, hueRect.W, hueRect.H / hueSegments + 1), Color3.fromHSV((index - 1) / (hueSegments - 1), 1, 1), alpha, zIndex + 6)
    end
    local hueMarker = namedDrawing(self, "overlay:color:hueMarker", "Square", { Filled = false })
    showSquare(hueMarker, rect(hueRect.X - 2, hueRect.Y + hue * hueRect.H - 2, hueRect.W + 4, 4), self.Theme.Text, alpha, zIndex + 12, false, 1)
    overlay.HueRegion.Rect = hueRect
    overlay.HueRegion.Z = zIndex + 25
    registerRegion(self, overlay.HueRegion)

    local detailsY = svRect.Y + svRect.H + 10
    if allowAlpha then
        local alphaRect = rect(x + 12, detailsY, width - 24, 18)
        overlay.AlphaRect = alphaRect
        local alphaSegments = 16
        for index = 1, alphaSegments do
            local segment = namedDrawing(self, "overlay:color:alpha:" .. index, "Square", { Filled = true })
            local segmentAlpha = (index - 1) / (alphaSegments - 1)
            showSquare(segment, rect(alphaRect.X + (index - 1) * alphaRect.W / alphaSegments, alphaRect.Y, alphaRect.W / alphaSegments + 1, alphaRect.H), color, alpha * segmentAlpha, zIndex + 6)
        end
        local alphaMarker = namedDrawing(self, "overlay:color:alphaMarker", "Line")
        showLine(alphaMarker, vector(alphaRect.X + colorAlpha * alphaRect.W, alphaRect.Y - 2), vector(alphaRect.X + colorAlpha * alphaRect.W, alphaRect.Y + alphaRect.H + 2), self.Theme.Text, alpha, 2, zIndex + 12)
        overlay.AlphaRegion.Rect = alphaRect
        overlay.AlphaRegion.Z = zIndex + 25
        registerRegion(self, overlay.AlphaRegion)
        detailsY = detailsY + 28
    end

    local hexRect = rect(x + 12, detailsY, 92, 28)
    local hexBackground = namedDrawing(self, "overlay:color:hexBg", "Square", { Filled = true })
    showSquare(hexBackground, hexRect, self.Theme.Input, alpha, zIndex + 6)
